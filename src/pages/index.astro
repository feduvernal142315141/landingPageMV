---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/sections/Hero.astro";
import WhyMenteVior from "../components/sections/WhyMenteVior.astro";
import Solutions from "../components/sections/Solutions.astro";
import SmartFeatures from "../components/sections/SmartFeatures.astro";
import Cta from "../components/sections/Cta.astro";
import Faq from "../components/sections/Faq.astro";
import Pricing from "../components/sections/Pricing.astro";
import Footer from "../components/Footer.astro";
---

<Layout showDemoButton={true}>
  <main>
    <Hero />
    <WhyMenteVior />
    <Solutions />
    <div class="h-px bg-gray-300 w-full mt-[30px]"></div>
    <SmartFeatures />
    <Pricing />
    <Faq />
    <Cta />
  </main>
  <Footer />
</Layout>

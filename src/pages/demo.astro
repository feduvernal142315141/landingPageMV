---
import Layout from "../layouts/Layout.astro";
import SimpleNav from "../components/SimpleNav.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";
---

<Layout
  title="Request a Demo | MenteVior"
  description="See MenteVior in action. Book a personalized walkthrough and discover how our all-in-one ABA practice management software transforms your clinical operations."
>
  <SimpleNav />
  <main class="pt-16 min-h-screen bg-navy-soft">
    <section class="relative overflow-hidden bg-navy">
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-tertiary/60 to-transparent"
      ></div>
      <div aria-hidden="true" class="pointer-events-none absolute inset-0">
        <div class="absolute left-1/2 top-0 h-96 w-96 -translate-x-1/2 rounded-full bg-accent/15 blur-3xl" />
        <div class="absolute bottom-0 right-1/4 h-72 w-72 rounded-full bg-primary/20 blur-3xl" />
      </div>

      <div class="relative mx-auto max-w-3xl px-6 py-20 text-center lg:py-28">
        <h1 class="text-3xl font-black tracking-tight text-white sm:text-4xl">
          Request a Demo
        </h1>
        <p class="mt-4 text-lg text-white/80">
          See how MenteVior can streamline your ABA practice. Fill out the form below and our team will schedule a personalized walkthrough.
        </p>
      </div>
    </section>

    <div class="mx-auto max-w-2xl px-6 py-16">
      <form class="space-y-6" onsubmit="return false;">
        <div class="grid gap-6 sm:grid-cols-2">
          <div>
            <label for="first-name" class="block text-sm font-bold text-navy">First Name</label>
            <input
              id="first-name"
              type="text"
              required
              class="mt-2 block w-full rounded-lg border border-navy/10 bg-white px-4 py-3 text-sm text-navy shadow-sm transition placeholder:text-navy/40 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20"
              placeholder="John"
            />
          </div>
          <div>
            <label for="last-name" class="block text-sm font-bold text-navy">Last Name</label>
            <input
              id="last-name"
              type="text"
              required
              class="mt-2 block w-full rounded-lg border border-navy/10 bg-white px-4 py-3 text-sm text-navy shadow-sm transition placeholder:text-navy/40 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20"
              placeholder="Doe"
            />
          </div>
        </div>
        <div>
          <label for="email" class="block text-sm font-bold text-navy">Work Email</label>
          <input
            id="email"
            type="email"
            required
            class="mt-2 block w-full rounded-lg border border-navy/10 bg-white px-4 py-3 text-sm text-navy shadow-sm transition placeholder:text-navy/40 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20"
            placeholder="you@clinic.com"
          />
        </div>
        <div>
          <label for="company" class="block text-sm font-bold text-navy">Company Name</label>
          <input
            id="company"
            type="text"
            required
            class="mt-2 block w-full rounded-lg border border-navy/10 bg-white px-4 py-3 text-sm text-navy shadow-sm transition placeholder:text-navy/40 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20"
            placeholder="Your ABA Practice"
          />
        </div>
        <div>
          <label for="role" class="block text-sm font-bold text-navy">Role</label>
          <select
            id="role"
            class="mt-2 block w-full rounded-lg border border-navy/10 bg-white px-4 py-3 text-sm text-navy shadow-sm transition focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20"
          >
            <option>BCBA / Clinical Director</option>
            <option>Practice Owner / Administrator</option>
            <option>Operations Manager</option>
            <option>Biller / Revenue Cycle</option>
            <option>Other</option>
          </select>
        </div>
        <div>
          <label for="message" class="block text-sm font-bold text-navy">Anything you'd like us to know?</label>
          <textarea
            id="message"
            rows="4"
            class="mt-2 block w-full rounded-lg border border-navy/10 bg-white px-4 py-3 text-sm text-navy shadow-sm transition placeholder:text-navy/40 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20"
            placeholder="Tell us about your practice size, current tools, or specific needs…"
          ></textarea>
        </div>
        <button
          type="submit"
          class="inline-flex items-center gap-2.5 rounded-lg bg-gradient-to-r from-primary via-accent to-tertiary px-8 py-3.5 text-sm font-bold text-white shadow-[0_8px_24px_rgba(3,126,204,0.4)] transition hover:shadow-[0_10px_28px_rgba(3,126,204,0.5)]"
        >
          Submit Request
        </button>
        <p class="text-xs text-navy/50">No spam. We'll only use your info to schedule your demo.</p>
      </form>
    </div>
  </main>
  <Footer />
</Layout>

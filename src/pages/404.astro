---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page Not Found | MenteVior" description="The page you're looking for doesn't exist or has been moved.">
  <main class="pt-16 min-h-screen bg-navy-soft flex items-center justify-center">
    <div class="text-center px-6">
      <h1 class="text-6xl font-black text-primary mb-4">404</h1>
      <h2 class="text-2xl font-bold text-white mb-4">Page Not Found</h2>
      <p class="text-lg text-white/80 mb-8 max-w-md mx-auto">
        Sorry, the page you're looking for doesn't exist or has been moved.
      </p>
      <a href="/" class="inline-flex items-center gap-2.5 rounded-lg bg-gradient-to-r from-primary via-accent to-tertiary px-6 py-3 text-sm font-bold text-white shadow-[0_8px_24px_rgba(3,126,204,0.4)] transition hover:shadow-[0_10px_28px_rgba(3,126,204,0.5)]">
        Go to Homepage
      </a>
    </div>
  </main>
</Layout>
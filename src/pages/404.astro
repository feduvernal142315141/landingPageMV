---
import Layout from "../layouts/Layout.astro";
import Button from "../components/ui/Button.astro";
---

<Layout title="Page Not Found | MenteVior" description="The page you're looking for doesn't exist or has been moved.">
  <main class="pt-16 min-h-screen bg-white flex items-center justify-center">
    <div class="text-center px-6">
      <h1 class="text-6xl font-black text-[hsl(var(--color-primary))] mb-4">404</h1>
      <h2 class="text-2xl font-black text-[hsl(var(--color-foreground))] mb-4">Page Not Found</h2>
      <p class="text-lg text-[hsl(var(--color-muted-foreground))] mb-8 max-w-md mx-auto">
        Sorry, the page you're looking for doesn't exist or has been moved.
      </p>
      <Button href="/" icon="home">Go to Homepage</Button>
    </div>
  </main>
</Layout>
---
import Layout from "../layouts/Layout.astro";
import { solutionCategories } from "../data/solutions";
import SolutionCategory from "../components/SolutionCategory.astro";
import Cta from "../components/sections/Cta.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Clinical Options & Company Configuration | MenteVior"
  description="Two unified suites: Clinical Options (client records, assessments, session notes, data collection, supervision) + Company Configuration (billing, HR, scheduling, credentials, compliance). One platform, zero data silos."
>
  <main class="relative pt-16 min-h-full bg-[hsl(var(--color-bg-primary))] bg-grid-pattern">
    <div class="mx-auto max-w-7xl px-6 py-16 relative">

      <!-- Clinical Options Section -->
      <section id="clinical-options" class="mt-2">
        <div class="text-center mb-14">
          <h2 class="text-3xl font-black tracking-tight text-[hsl(var(--color-foreground))] sm:text-4xl">
            Clinical Options
          </h2>
          <p class="mt-4 text-lg text-[hsl(var(--color-muted-foreground))] font-normal tracking-wide text-center">
            Clinical workflows for ABA therapy
          </p>
        </div>
        <SolutionCategory category={solutionCategories[0]} showCard={false} showExplore={true} baseUrl="" showWrapper={false} />
      </section>

      <!-- Company Configuration Section -->
      <section id="company-configuration" class="mt-32">
        <div class="text-center mb-14">
          <h2 class="text-3xl font-black tracking-tight text-[hsl(var(--color-foreground))] sm:text-4xl">
            Company Configuration
          </h2>
          <p class="mt-4 text-lg text-[hsl(var(--color-muted-foreground))] font-normal tracking-wide text-center">
            Business operations & admin
          </p>
        </div>
        <SolutionCategory category={solutionCategories[1]} showCard={false} showExplore={true} baseUrl="" showWrapper={false} />
      </section>

    </div>
    <Cta />
  </main>
  <Footer />
</Layout>
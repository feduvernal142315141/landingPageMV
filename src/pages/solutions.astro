---
import Layout from "../layouts/Layout.astro";
import { solutionCategories } from "../data/solutions";
import SolutionCategory from "../components/SolutionCategory.astro";
import Cta from "../components/Cta.astro";
import Footer from "../components/Footer.astro";
import Icon from "../components/ui/Icon.astro";
---

<Layout
  title="Clinical Options & Company Configuration | MenteVior"
  description="Explore MenteVior's Clinical Options and Company Configuration modules — a complete suite of integrated modules designed to work together, out of the box."
>
  <main class="relative pt-16 min-h-full bg-gradient-to-b from-navy to-dark-accent">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0">
      <div class="absolute -top-24 right-1/4 h-80 w-80 rounded-full bg-accent/10 blur-3xl" />
      <div class="absolute bottom-0 left-1/4 h-72 w-72 rounded-full bg-primary/10 blur-3xl" />
      <!-- Floating icons -->
      <Icon name="sparkles" class="absolute top-20 left-10 h-5 w-5 text-white/10 animate-float-rotate" style="animation-delay: -3s;" />
      <Icon name="compass" class="absolute top-32 left-20 h-5 w-5 text-white/10 animate-float-drift" style="animation-delay: -8s;" />
      <Icon name="layout-dashboard" class="absolute top-20 right-12 h-5 w-5 text-white/10 animate-float-drift" style="animation-delay: -1s;" />
      <Icon name="book-open" class="absolute top-40 right-16 h-5 w-5 text-white/10 animate-float-rotate" style="animation-delay: -12s;" />
      <Icon name="sparkles" class="absolute top-28 left-1/2 -translate-x-1/2 h-5 w-5 text-white/10 animate-float-pulse" style="animation-delay: -4s;" />
      <Icon name="compass" class="absolute top-44 left-1/2 -translate-x-1/2 h-5 w-5 text-white/10 animate-float-rotate" style="animation-delay: -11s;" />
      <Icon name="layout-dashboard" class="absolute top-16 left-1/2 -translate-x-1/2 h-5 w-5 text-white/10 animate-float-drift" style="animation-delay: -7s;" />
      <Icon name="calendar" class="absolute left-8 top-1/2 h-5 w-5 text-white/10 animate-float-pulse" style="animation-delay: -5s;" />
      <Icon name="layout-dashboard" class="absolute left-16 top-2/3 h-5 w-5 text-white/10 animate-float-rotate" style="animation-delay: -14s;" />
      <Icon name="compass" class="absolute right-10 top-1/3 h-5 w-5 text-white/10 animate-float-drift" style="animation-delay: -6s;" />
      <Icon name="sparkles" class="absolute right-14 top-3/4 h-5 w-5 text-white/10 animate-float-pulse" style="animation-delay: -9s;" />
      <Icon name="book-open" class="absolute bottom-20 left-1/3 h-5 w-5 text-white/10 animate-float-drift" style="animation-delay: -10s;" />
      <Icon name="calendar" class="absolute bottom-16 right-1/4 h-5 w-5 text-white/10 animate-float-rotate" style="animation-delay: -2s;" />
      <!-- Extra icons for Company Configuration area (lower portion) -->
      <Icon name="shield" class="absolute bottom-32 left-1/4 h-5 w-5 text-white/10 animate-float-pulse" style="animation-delay: -1s;" />
      <Icon name="database" class="absolute bottom-28 right-1/3 h-5 w-5 text-white/10 animate-float-drift" style="animation-delay: -4s;" />
      <Icon name="users" class="absolute bottom-40 left-1/2 -translate-x-1/2 h-5 w-5 text-white/10 animate-float-rotate" style="animation-delay: -7s;" />
      <Icon name="file-text" class="absolute bottom-24 right-1/2 -translate-x-1/2 h-5 w-5 text-white/10 animate-float-pulse" style="animation-delay: -9s;" />
      <Icon name="dollar" class="absolute bottom-36 left-3/4 h-5 w-5 text-white/10 animate-float-drift" style="animation-delay: -12s;" />
      <Icon name="badge-check" class="absolute bottom-12 right-1/5 h-5 w-5 text-white/10 animate-float-rotate" style="animation-delay: -15s;" />
    </div>
    <div class="mx-auto max-w-7xl px-6 py-16 relative">

      <!-- Clinical Options Section -->
      <section id="clinical-options" class="mt-2">
        <div class="text-center mb-14">
          <h2 class="text-3xl font-black tracking-tight text-white sm:text-4xl">
            Clinical Options
          </h2>
          <p class="mt-4 text-lg text-white/70 font-normal tracking-wide text-center">
            Clinical workflows for ABA therapy
          </p>
        </div>
        <SolutionCategory category={solutionCategories[0]} showCard={false} showExplore={true} baseUrl="" showWrapper={false} />
      </section>

      <!-- Company Configuration Section -->
      <section id="company-configuration" class="mt-32">
        <div class="text-center mb-14">
          <h2 class="text-3xl font-black tracking-tight text-white sm:text-4xl">
            Company Configuration
          </h2>
          <p class="mt-4 text-lg text-white/70 font-normal tracking-wide text-center">
            Business operations & admin
          </p>
        </div>
        <SolutionCategory category={solutionCategories[1]} showCard={false} showExplore={true} baseUrl="" showWrapper={false} />
      </section>

    </div>
    <Cta />
  </main>
  <Footer />
</Layout>

<style is:global>
  @keyframes float-rotate {
    0% { transform: translate(0, 0) rotate(0deg); }
    25% { transform: translate(15px, -15px) rotate(90deg); }
    50% { transform: translate(-10px, 20px) rotate(180deg); }
    75% { transform: translate(-20px, -10px) rotate(270deg); }
    100% { transform: translate(0, 0) rotate(360deg); }
  }
  @keyframes float-drift {
    0%, 100% { transform: translate(0, 0); }
    25% { transform: translate(20px, -10px); }
    50% { transform: translate(-15px, 15px); }
    75% { transform: translate(10px, 20px); }
  }
  @keyframes float-pulse {
    0%, 100% { opacity: 0.015; transform: scale(1); }
    50% { opacity: 0.04; transform: scale(1.02); }
  }
  .animate-float-rotate { animation: float-rotate 22s linear infinite; will-change: transform; }
  .animate-float-drift { animation: float-drift 18s ease-in-out infinite; will-change: transform; }
  .animate-float-pulse { animation: float-pulse 10s ease-in-out infinite; will-change: transform, opacity; }
  @media (prefers-reduced-motion: reduce) {
    .animate-float-rotate, .animate-float-drift, .animate-float-pulse { animation: none; }
  }
</style>
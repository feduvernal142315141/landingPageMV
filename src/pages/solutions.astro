---
import Layout from "../layouts/Layout.astro";
import SimpleNav from "../components/SimpleNav.astro";
import { solutionCategories } from "../data/solutions";
import SolutionCategory from "../components/SolutionCategory.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Clinical Options & Company Configuration | MenteVior"
  description="Explore MenteVior's Clinical Options and Company Configuration modules — a complete suite of integrated modules designed to work together, out of the box."
>
  <SimpleNav />
  <main class="pt-16 min-h-screen bg-navy-dark">
    <div class="mx-auto max-w-7xl px-6 py-16">
      {solutionCategories.map((category) => (
        <SolutionCategory category={category} showExplore={true} />
      ))}
    </div>
  </main>
  <Footer />
</Layout>
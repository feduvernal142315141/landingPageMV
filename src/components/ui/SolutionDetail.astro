---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
  bullets: { text: string; icon: string }[];
  screenshot: string;
  alt: string;
  reversed?: boolean;
  id?: string;
  animate?: boolean;
}

const { eyebrow, title, description, bullets, screenshot, alt, reversed = false, id, animate = false } = Astro.props;

import { icons } from "../../data/icons";

const textDirection = reversed ? "slide-right" : "slide-left";
const imageDirection = reversed ? "slide-left" : "slide-right";
---

<section
  class:list={[
    "flex flex-col items-center gap-16 py-24 lg:flex-row lg:items-center lg:gap-24 lg:py-32",
    !animate && "scroll-reveal",
    reversed && "lg:flex-row-reverse",
  ]}
>
  <!-- Text content -->
  <div class:list={["flex-1 space-y-6", animate && `scroll-reveal ${textDirection}`]}>
    <span id={id} class:list={["inline-flex items-center px-4 py-1.5 rounded-full bg-[hsl(var(--color-primary))]/10 border border-[hsl(var(--color-primary))]/20 text-sm font-bold uppercase tracking-widest text-[hsl(var(--color-primary))]", animate && `scroll-reveal ${textDirection}`]} style={`scroll-margin-top: 80px;${animate ? ' transition-delay: 0ms;' : ''}`}>
      {eyebrow}
    </span>
    <h3 class:list={["text-3xl font-bold tracking-tight sm:text-4xl text-[hsl(var(--color-foreground))]", animate && `scroll-reveal ${textDirection}`]} style={animate ? "transition-delay: 100ms;" : undefined}>
      {title}
    </h3>
    <p class:list={["text-lg text-[hsl(var(--color-muted-foreground))] leading-relaxed", animate && `scroll-reveal ${textDirection}`]} style={animate ? "transition-delay: 200ms;" : undefined}>
      {description}
    </p>
    <ul class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-3">
      {bullets.map((bullet, i) => (
        <li class:list={["flex items-start gap-3 rounded-xl bg-[hsl(var(--color-primary))]/5 border border-[hsl(var(--color-primary))]/10 p-4", animate && "scroll-reveal slide-up"]} style={animate ? `transition-delay: ${300 + i * 100}ms;` : undefined}>
          <svg class="mt-0.5 h-5 w-5 shrink-0 text-[hsl(var(--color-primary))]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" set:html={icons[bullet.icon]} />
          <span class="font-bold text-[hsl(var(--color-foreground))]">{bullet.text}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Screenshot -->
  <div class:list={["flex-1", animate && `scroll-reveal ${imageDirection}`]}>
    <div class="rounded-2xl p-[10px] bg-[hsl(32,12%,97%)] border border-[hsl(240,20%,85%)] transition-all duration-300 hover:shadow-[0_12px_40px_rgba(15,23,42,0.18)] hover:-translate-y-2">
      <div class="relative overflow-hidden rounded-2xl border border-[hsl(240,20%,85%)] shadow-[0_4px_24px_rgba(15,23,42,0.08)]">
        <img
          src={screenshot}
          alt={alt}
          class="h-auto w-full object-cover"
          loading="lazy"
        />
      </div>
    </div>
  </div>
</section>

---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
  bullets: { text: string; icon: string }[];
  screenshot: string;
  alt: string;
  reversed?: boolean;
  id?: string;
}

const { eyebrow, title, description, bullets, screenshot, alt, reversed = false, id } = Astro.props;

import { icons } from "../../data/icons";
---

<section
  id={id}
  class:list={[
    "scroll-reveal scroll-mt-24 flex flex-col items-center gap-16 py-24 lg:flex-row lg:items-center lg:gap-24 lg:py-32",
    reversed && "lg:flex-row-reverse",
  ]}
>
  <!-- Text content -->
  <div class="flex-1 space-y-6">
    <span class="inline-flex items-center px-4 py-1.5 rounded-full bg-[hsl(var(--color-primary))]/10 border border-[hsl(var(--color-primary))]/20 text-sm font-bold uppercase tracking-widest text-[hsl(var(--color-primary))]">
      {eyebrow}
    </span>
    <h3 class="text-3xl font-bold tracking-tight sm:text-4xl text-[hsl(var(--color-foreground))]">
      {title}
    </h3>
    <p class="text-lg text-[hsl(var(--color-muted-foreground))] leading-relaxed">
      {description}
    </p>
    <ul class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-3">
      {bullets.map((bullet) => (
        <li class="flex items-start gap-3 rounded-xl bg-[hsl(var(--color-primary))]/5 border border-[hsl(var(--color-primary))]/10 p-4">
          <svg class="mt-0.5 h-5 w-5 shrink-0 text-[hsl(var(--color-primary))]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" set:html={icons[bullet.icon]} />
          <span class="font-bold text-[hsl(var(--color-foreground))]">{bullet.text}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Screenshot -->
  <div class="flex-1">
    <div class="relative overflow-hidden rounded-2xl border border-[hsl(var(--color-border))] shadow-[0_4px_24px_rgba(15,23,42,0.08)]">
      <img
        src={screenshot}
        alt={alt}
        class="h-auto w-full object-cover"
        loading="lazy"
      />
    </div>
  </div>
</section>

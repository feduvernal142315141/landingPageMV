---
import Icon from "./Icon.astro";

interface Props {
  href: string;
  variant?: "primary" | "secondary" | "outline" | "ghost" | "hero" | "cta-primary" | "cta-primary-outline" | "cta-secondary";
  icon?: string;
  class?: string;
}

const { href, variant = "primary", icon, class: className = "" } = Astro.props;

const variants: Record<string, string> = {
  primary:
    "inline-flex items-center gap-2.5 rounded-lg bg-gradient-to-r from-[hsl(var(--color-primary))] to-[hsl(210_90%_65%)] px-6 py-3 text-sm font-bold text-[hsl(var(--color-primary-foreground))] shadow-[0_8px_24px_rgba(59,130,246,0.4)] transition hover:shadow-[0_10px_28px_rgba(59,130,246,0.5)] hover:from-[hsl(var(--color-primary))] hover:to-[hsl(210_90%_60%)]",
  secondary:
    "inline-flex items-center gap-2.5 rounded-lg border border-[hsl(var(--color-border))] bg-white px-6 py-3 text-sm font-bold text-[hsl(var(--color-foreground))] transition hover:bg-[hsl(var(--color-muted))] hover:border-[hsl(var(--color-primary))]",
  outline:
    "inline-flex items-center gap-2.5 rounded-lg border border-[hsl(var(--color-border))] bg-transparent px-6 py-3 text-sm font-bold text-[hsl(var(--color-foreground))] transition hover:bg-[hsl(var(--color-muted))] hover:border-[hsl(var(--color-primary))]",
  ghost:
    "inline-flex items-center gap-2.5 rounded-lg px-6 py-3 text-sm font-bold text-[hsl(var(--color-foreground))] transition hover:bg-[hsl(var(--color-muted))]",
  hero:
    "inline-flex items-center gap-2.5 rounded-2xl border-2 border-[hsl(210,80%,60%)] bg-gradient-to-r from-white via-white to-[hsl(210,60%,92%)] px-6 py-3 text-base font-bold text-[hsl(210,80%,60%)] transition-all duration-300 hover:bg-none hover:bg-[hsl(210,70%,55%)] hover:text-white hover:border-[hsl(210,70%,55%)]",
  "cta-primary":
    "inline-flex items-center gap-2.5 rounded-lg bg-[hsl(var(--color-primary))] px-6 py-3 text-sm font-bold text-[hsl(var(--color-primary-foreground))] shadow-[0_8px_24px_rgba(59,130,246,0.4)] transition hover:bg-[hsl(var(--color-primary))]/90 hover:shadow-[0_10px_28px_rgba(59,130,246,0.5)]",
  "cta-primary-outline":
    "inline-flex items-center gap-2.5 rounded-2xl border-2 border-white bg-white px-6 py-3 text-sm font-bold text-[hsl(var(--color-primary))] shadow-[0_8px_24px_rgba(255,255,255,0.3)] transition hover:bg-white/90 hover:shadow-[0_10px_28px_rgba(255,255,255,0.4)]",
  "cta-secondary":
    "inline-flex items-center gap-2.5 rounded-2xl border-2 border-[hsl(var(--color-primary-foreground))] bg-transparent px-6 py-3 text-sm font-bold tracking-wide text-[hsl(var(--color-primary-foreground))] transition hover:bg-[hsl(var(--color-foreground))] hover:border-[hsl(var(--color-foreground))]",
  "cta-navy":
    "inline-flex items-center gap-2.5 rounded-lg border-2 border-[hsl(var(--color-foreground))] bg-[hsl(var(--color-bg-warm))] px-6 py-3 text-sm font-bold tracking-wide text-[hsl(var(--color-foreground))]",
};

const baseStyles = "inline-flex items-center justify-center";

const dataAttrs = Object.fromEntries(
  Object.entries(Astro.props).filter(([key]) => key.startsWith("data-"))
);

---
<a href={href} class={`${variants[variant]} ${className} ${baseStyles} ${variant === 'cta-primary' ? 'btn-coin-shine' : ''}`.trim()} {...dataAttrs}>
  {variant === 'cta-primary' && <span class="coin-shine" aria-hidden="true"></span>}
  {icon && <Icon name={icon} class="h-6 w-6" />}
  <slot />
</a>

<style is:global>
  /* Hero variant uses larger icons (24px) to match demo button */
  .btn-hero-icon .h-4.w-4,
  .btn-hero-icon .h-4.w-4 {
    width: 1.5rem !important;
    height: 1.5rem !important;
  }

  a.rounded-2xl.border-2.border-\[hsl\(210\,80\%\,60\%\)\] {
    border-top-width: 3px;
    border-left-width: 3px;
  }

  a.rounded-2xl.border-2.border-\[hsl\(var\(--color-primary-foreground\)\)\] {
    border-top-width: 3px;
    border-left-width: 3px;
  }

  .btn-coin-shine {
    position: relative !important;
    overflow: hidden;
  }

  .btn-coin-shine .coin-shine {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    overflow: hidden;
    z-index: 1;
  }

  .btn-coin-shine .coin-shine::before {
    content: "";
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: linear-gradient(
      35deg,
      transparent 48%,
      rgba(255, 255, 255, 0.95) 50%,
      transparent 52%
    );
    transform: translateX(-100%) rotate(35deg);
    animation: btn-coin-shine 7s ease-in-out infinite;
    opacity: 0;
  }

  @keyframes btn-coin-shine {
    0% {
      transform: translateX(-100%) rotate(35deg);
      opacity: 0;
    }
    4% {
      opacity: 1;
    }
    41.4% {
      transform: translateX(100%) rotate(35deg);
      opacity: 1;
    }
    45.4% {
      opacity: 0;
    }
    100% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .btn-coin-shine .coin-shine::before {
      animation: none;
      opacity: 0;
    }
  }
</style>
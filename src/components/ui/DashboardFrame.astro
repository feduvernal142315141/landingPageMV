---
import { Image } from "astro:assets";
---

<div class="dashboard-frame-3d">
  <div class="dashboard-frame-inner">
    <!-- Coin shine - fast clean beam -->
    <div class="dashboard-coin-shine" aria-hidden="true"></div>
    
    <!-- Browser header with 3 dots (brand colors) + title -->
    <div class="dashboard-header">
      <div class="dashboard-dots">
        <span class="dashboard-dot dot-blue" aria-hidden="true"></span>
        <span class="dashboard-dot dot-navy" aria-hidden="true"></span>
        <span class="dashboard-dot dot-purple" aria-hidden="true"></span>
      </div>
      <span class="dashboard-title">MenteVior Dashboard</span>
    </div>
    
    <!-- Dashboard display -->
    <div class="dashboard-display">
      <Image
        src={await import("../../assets/mentevior-dashboard.png").then(m => m.default)}
        alt="MenteVior dashboard preview"
        width={1200}
        height={750}
        class="dashboard-image"
      />
    </div>
    
    <!-- Screen glare overlay -->
    <div class="dashboard-glare" aria-hidden="true"></div>
    
    <!-- Projected shadow on background -->
    <div class="dashboard-shadow" aria-hidden="true"></div>
  </div>
</div>

<style>
  .dashboard-frame-3d {
    perspective: 1000px;
    width: 100%;
    max-width: 900px;
    margin-left: auto;
  }

  .dashboard-frame-inner {
    /* Layout & 3D */
    transform-style: preserve-3d;
    transform: perspective(1000px) rotateY(-2deg) translateZ(-20px) translateY(-20px);
    transform-origin: center center;
    transition: transform 500ms cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
    position: relative;

    /* Clean border & shadow */
    border: 1px solid hsl(var(--color-border));
    border-radius: 12px;
    background: hsl(var(--color-bg-primary));
    box-shadow: 
      0 20px 64px -12px rgba(15, 23, 42, 0.35),
      0 8px 32px -8px rgba(15, 23, 42, 0.25);
    overflow: hidden;
    position: relative;
    aspect-ratio: 1366 / 777;
  }

  .dashboard-frame-3d:hover .dashboard-frame-inner {
    transform: perspective(1000px) rotateY(0deg) translateZ(0) translateY(-20px);
  }

  /* Coin shine - single clean beam sweep via transform */
  .dashboard-coin-shine {
    position: absolute;
    inset: 1px; /* Inside the border */
    border-radius: 10px; /* Match frame 12px - 1px inset */
    pointer-events: none;
    z-index: 8;
    overflow: hidden;
  }

  .dashboard-coin-shine::before {
    content: "";
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    /* Single narrow beam at 35° */
    background: linear-gradient(
      35deg,
      transparent 48%,
      rgba(255, 255, 255, 0.95) 50%,
      transparent 52%
    );
    /* Start off-screen left, sweep to off-screen right */
    transform: translateX(-100%) rotate(35deg);
    animation: coin-shine 8s ease-in-out infinite;
    opacity: 0;
  }

  @keyframes coin-shine {
    0% {
      transform: translateX(-100%) rotate(35deg);
      opacity: 0;
    }
    2% {
      opacity: 1;
    }
    41.4% {
      transform: translateX(100%) rotate(35deg);
      opacity: 1;
    }
    43.4% {
      opacity: 0;
    }
    100% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dashboard-coin-shine::before {
      animation: none;
      opacity: 0;
    }
  }

  .dashboard-header {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    gap: 12px;
    padding: 21px 16px 14px 16px;  /* Half thickness */
    background: linear-gradient(180deg,
      hsl(210 15% 94%) 0%,
      hsl(210 10% 90%) 100%
    );
    border-radius: 12px 12px 0 0;
    border-bottom: 1px solid hsl(210 15% 75% / 0.5);
  }

  .dashboard-dots {
    position: absolute;
    left: 16px;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    gap: 8px;
    margin-left: 0;
  }

  .dashboard-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .dot-blue {
    background: hsl(var(--color-primary));  /* Primary blue */
    box-shadow: 0 0 0 2px hsl(var(--color-primary) / 0.2);
  }

  .dot-navy {
    background: hsl(var(--color-foreground));  /* Navy */
    box-shadow: 0 0 0 2px hsl(var(--color-foreground) / 0.2);
  }

  .dot-purple {
    background: hsl(270 80% 55%);  /* Purple */
    box-shadow: 0 0 0 2px hsl(270 80% 55% / 0.2);
  }

  .dashboard-title {
    font: 700 1rem/1 "Satoshi", sans-serif;
    color: hsl(var(--color-muted-foreground));  /* Gray for contrast */
    white-space: nowrap;
  }

  .dashboard-display {
    overflow: hidden;
    background: hsl(var(--color-bg-primary));  /* OPAQUE - not transparent */
    border-radius: 0 0 12px 12px;  /* Square top, rounded bottom */
  }

  .dashboard-image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;  /* Show full image */
    border-radius: 0 0 12px 12px;  /* Square top, rounded bottom */
  }

  /* Screen glare overlay */
  .dashboard-glare {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    pointer-events: none;
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.15) 0%,
      transparent 50%,
      rgba(0, 0, 0, 0.05) 100%
    );
    border-radius: 12px 12px 0 0;
    opacity: 0.4;
  }

  /* Projected shadow on background - enhanced visibility */
  .dashboard-shadow {
    position: absolute;
    bottom: -80px;
    left: 5px;
    right: 5px;
    height: 140px;
    background: radial-gradient(
      ellipse at center bottom,
      rgba(15, 23, 42, 0.5) 0%,
      rgba(15, 23, 42, 0.3) 35%,
      rgba(15, 23, 42, 0.1) 65%,
      transparent 80%
    );
    filter: blur(10px);
    border-radius: 50%;
    pointer-events: none;
    z-index: -1;
    transform: translateZ(-10px);
  </style>
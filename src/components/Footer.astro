---
import { site } from "../data/site";
import BrandLockup from "./BrandLockup.astro";
import Copyright from "./Copyright.astro";
import FooterHeading from "./FooterHeading.astro";
import Icon from "./ui/Icon.astro";
import SocialLinks from "./SocialLinks.astro";
---

<footer id="footer" class="relative overflow-hidden bg-[hsl(var(--color-footer-bg))]">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-[hsl(var(--color-primary))]/40 to-transparent"
  ></div>

  <div class="relative mx-auto max-w-7xl px-6 py-16">
    <div class="grid grid-cols-1 gap-y-12 lg:grid-cols-12 lg:gap-12 lg:gap-y-0">
      <div class="lg:col-span-5">
        <BrandLockup href="/" inverted />
        <p class="mt-5 max-w-sm text-sm leading-relaxed text-[hsl(var(--color-footer-muted))]">
          Patient care first. Everything else, handled.
        </p>
        <p class="mt-5 max-w-sm text-sm leading-relaxed text-[hsl(var(--color-footer-muted))]">
          Made for the ABA Comunity
        </p>
        <div class="mt-7">
          <SocialLinks />
        </div>
      </div>

      <div class="lg:col-span-2 text-center lg:text-left">
        <FooterHeading class="text-[hsl(var(--color-footer-text))]">Product</FooterHeading>
        <ul class="mt-5 space-y-3 text-left">
          <li>
            <a href="/" class="text-sm text-[hsl(var(--color-footer-text))] transition hover:text-[hsl(var(--color-primary))]" data-home-link>Home</a>
          </li>
          <li>
            <a href="/#features" class="text-sm text-[hsl(var(--color-footer-text))] transition hover:text-[hsl(var(--color-primary))]">Features</a>
          </li>
          <li>
            <a href="/#solutions" class="text-sm text-[hsl(var(--color-footer-text))] transition hover:text-[hsl(var(--color-primary))]">Solutions</a>
          </li>
        </ul>
      </div>

      <div class="lg:col-span-2 text-center lg:text-left">
        <FooterHeading class="text-[hsl(var(--color-footer-text))]">Legal</FooterHeading>
        <ul class="mt-5 space-y-3 text-left">
          <li>
            <a href="#" class="text-sm text-[hsl(var(--color-footer-text))] transition hover:text-[hsl(var(--color-primary))]">Privacy</a>
          </li>
          <li>
            <a href="#" class="text-sm text-[hsl(var(--color-footer-text))] transition hover:text-[hsl(var(--color-primary))]">Terms</a>
          </li>
        </ul>
      </div>

      <div class="lg:col-span-3 text-center lg:text-left">
        <FooterHeading class="text-[hsl(var(--color-footer-text))]">Contact</FooterHeading>
        <ul class="mt-5 space-y-3 text-left">
          <li>
            <a
              href={`mailto:${site.contact.email}`}
              class="group inline-flex items-center gap-2.5 text-sm text-[hsl(var(--color-footer-muted))] transition hover:text-[hsl(var(--color-primary))]"
            >
              <Icon name="mail" class="h-4 w-4 text-[hsl(var(--color-footer-muted))] transition group-hover:text-[hsl(var(--color-primary))]" />
              <span class="text-[hsl(var(--color-footer-muted))]">{site.contact.email}</span>
            </a>
          </li>
          <li class="inline-flex items-center gap-2.5 text-[hsl(var(--color-footer-muted))]">
            <Icon name="phone" class="h-4 w-4 text-[hsl(var(--color-footer-muted))]" />
            <span class="text-sm">{site.contact.phone}</span>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-16 border-t border-white/10 pt-8">
      <Copyright class="text-center text-sm text-[hsl(var(--color-footer-muted))]" />
    </div>
  </div>
</footer>

<script>
  const homeLinks = document.querySelectorAll<HTMLAnchorElement>("[data-home-link]");
  homeLinks.forEach((homeLink) => {
    homeLink.addEventListener("click", (e) => {
      if (window.location.pathname === "/") {
        e.preventDefault();
        window.scrollTo({ top: 0, behavior: "smooth" });
      }
    });
  });
</script>
---
import { site } from "../data/site";

const socialIcons: Record<string, string> = {
  LinkedIn:
    '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/>',
  Instagram:
    '<rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>',
  Facebook:
    '<path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>',
};

const iconMail =
  '<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>';

const iconPhone =
  '<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/>';
---

<footer id="footer" class="relative overflow-hidden bg-navy-soft">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-primary/60 to-transparent"
  ></div>

  <div class="relative mx-auto max-w-7xl px-6 py-16">
    <div class="grid grid-cols-2 gap-10 lg:grid-cols-12 lg:gap-12">
      <div class="col-span-2 lg:col-span-5">
        <a href="/" class="inline-flex items-center gap-2" aria-label={`${site.name} home`}>
          <img
            src="/MenteVior-logo.png"
            alt={`${site.name} logo`}
            class="h-12 w-auto brightness-[10] contrast-[0.9]"
          />
          <img
            src="/MenteVior-name.png"
            alt={site.name}
            class="h-6 w-auto brightness-[10] contrast-[0.9]"
          />
        </a>
        <p class="mt-5 max-w-sm text-sm leading-relaxed text-white/60">
          Built to help ABA teams focus on patients, not paperwork.
        </p>
        <p class="mt-5 max-w-sm text-sm leading-relaxed text-white/60">
          HIPAA-compliant · Secure by design
        </p>
        <div class="mt-7 flex items-center gap-3">
          {
            site.social.map((s) => (
              <a
                href={s.href}
                aria-label={s.label}
                class="rounded-xl border border-white/10 bg-white/5 p-2.5 text-white/70 transition hover:-translate-y-0.5 hover:border-tertiary/50 hover:text-tertiary"
              >
                <svg
                  class="h-5 w-5"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={socialIcons[s.label] ?? '<circle cx="12" cy="12" r="10"/>'}
                />
              </a>
            ))
          }
        </div>
      </div>

      <div class="lg:col-span-3">
        <h3 class="text-xs font-semibold uppercase tracking-widest text-white/80">Product</h3>
        <ul class="mt-5 space-y-3">
          {
            site.nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-sm text-white/60 transition hover:text-white"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="lg:col-span-4">
        <h3 class="text-xs font-semibold uppercase tracking-widest text-white/80">Contact</h3>
        <ul class="mt-5 space-y-3 text-sm text-white/60">
          <li>
            <a
              href={`mailto:${site.contact.email}`}
              class="group inline-flex items-center gap-2.5 transition hover:text-white"
            >
              <svg
                class="h-4 w-4 text-white/40 transition group-hover:text-tertiary"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={iconMail}
              />
              {site.contact.email}
            </a>
          </li>
          <li class="inline-flex items-center gap-2.5">
            <svg
              class="h-4 w-4 text-white/40"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              set:html={iconPhone}
            />
            {site.contact.phone}
          </li>
        </ul>
        <a
          href={site.demoUrl}
          class="mt-7 inline-flex items-center gap-2 text-sm font-semibold text-tertiary transition hover:text-white"
        >
          Request a demo
          <svg
            class="h-4 w-4 transition-transform group-hover:translate-x-0.5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>

    <div
      class="mt-16 flex flex-col items-center justify-between gap-5 border-t border-white/10 pt-8 sm:flex-row"
    >
      <p class="text-xs text-white/40">
        © {new Date().getFullYear()} {site.name}. All rights reserved.
      </p>
      <div class="flex items-center gap-6 text-xs text-white/40">
        <a href="#" class="transition hover:text-white/80">Privacy</a>
        <a href="#" class="transition hover:text-white/80">Terms</a>
        <a href="#top" class="transition hover:text-white/80">Back to top ↑</a>
      </div>
    </div>
  </div>
</footer>
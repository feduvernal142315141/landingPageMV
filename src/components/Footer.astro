---
import { site } from "../data/site";
import BrandLockup from "./BrandLockup.astro";
import Copyright from "./Copyright.astro";
import FooterHeading from "./FooterHeading.astro";
---

<footer id="footer" class="relative overflow-hidden bg-[hsl(var(--color-footer-bg))]">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-[hsl(var(--color-primary))]/40 to-transparent"
  ></div>

  <div class="relative mx-auto max-w-7xl px-6 py-16">
    <div class="grid grid-cols-1 gap-y-12 lg:grid-cols-12 lg:gap-12 lg:gap-y-0">
      <div class="lg:col-span-5">
        <BrandLockup href="/" inverted />
        <p class="mt-5 max-w-sm text-sm leading-relaxed text-[hsl(var(--color-footer-muted))]">
          Patient care first. Everything else, handled.
        </p>
        <p class="mt-5 max-w-sm text-sm leading-relaxed text-[hsl(var(--color-footer-muted))]">
          Made for the ABA Comunity
        </p>
      </div>

      <div class="lg:col-span-2 text-center lg:text-left ml-[50px]">
        <FooterHeading class="text-[hsl(var(--color-footer-text))]">Product</FooterHeading>
        <ul class="mt-5 space-y-3 text-left">
          <li>
            <a href="/" class="text-base text-[hsl(var(--color-footer-text))] transition hover:text-[hsl(var(--color-primary))]" data-home-link>Home</a>
          </li>
          <li>
            <a href="/#solutions" class="text-base text-[hsl(var(--color-footer-text))] transition hover:text-[hsl(var(--color-primary))]">Solutions</a>
          </li>
          <li>
            <a href="/#features" class="text-base text-[hsl(var(--color-footer-text))] transition hover:text-[hsl(var(--color-primary))]">Features</a>
          </li>
          <li>
            <a href="/#pricing" class="text-base text-[hsl(var(--color-footer-text))] transition hover:text-[hsl(var(--color-primary))]">Pricing</a>
          </li>
        </ul>
      </div>

      <div class="lg:col-span-5 text-center lg:text-left ml-[50px]">
        <FooterHeading class="text-[hsl(var(--color-footer-text))]">Company</FooterHeading>
        <ul class="mt-5 space-y-3 text-left">
          <li>
            <a href="/#faq" class="text-base text-[hsl(var(--color-footer-text))] transition hover:text-[hsl(var(--color-primary))]">FAQ</a>
          </li>
          <li>
            <a href="#" class="text-base text-[hsl(var(--color-footer-text))] transition hover:text-[hsl(var(--color-primary))]">Privacy</a>
          </li>
          <li>
            <a href="#" class="text-base text-[hsl(var(--color-footer-text))] transition hover:text-[hsl(var(--color-primary))]">Terms</a>
          </li>
          <li>
            <a href={`mailto:${site.contact.email}`} class="text-base text-[hsl(var(--color-footer-text))] transition hover:text-[hsl(var(--color-primary))]">Contact</a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-16 border-t border-white/10 pt-8">
      <Copyright class="text-center text-sm text-[hsl(var(--color-footer-muted))]" />
    </div>
  </div>
</footer>

<script>
  const homeLinks = document.querySelectorAll<HTMLAnchorElement>("[data-home-link]");
  homeLinks.forEach((homeLink) => {
    homeLink.addEventListener("click", (e) => {
      if (window.location.pathname === "/") {
        e.preventDefault();
        window.scrollTo({ top: 0, behavior: "smooth" });
      }
    });
  });
</script>
---
import { site } from "../data/site";
import BrandLockup from "./BrandLockup.astro";
import Copyright from "./Copyright.astro";
import FooterHeading from "./FooterHeading.astro";
import Icon from "./Icon.astro";
import SocialLinks from "./SocialLinks.astro";
---

<footer id="footer" class="relative overflow-hidden bg-navy-dark">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-primary/60 to-transparent"
  ></div>

  <div class="relative mx-auto max-w-7xl px-6 py-16">
    <div class="grid grid-cols-1 gap-y-12 lg:grid-cols-12 lg:gap-12 lg:gap-y-0">
      <div class="lg:col-span-5">
        <BrandLockup inverted href="/" />
        <p class="mt-5 max-w-sm text-sm leading-relaxed text-white/60">
          Patient care first. Everything else, handled.
        </p>
        <p class="mt-5 max-w-sm text-sm leading-relaxed text-white/60">
          HIPAA-compliant · Secure by design
        </p>
        <div class="mt-7">
          <SocialLinks />
        </div>
      </div>

      <div class="lg:col-span-2 text-center lg:text-left">
        <FooterHeading>Product</FooterHeading>
        <ul class="mt-5 space-y-3 text-left">
          <li>
            <a href="/" class="text-sm text-white/60 transition hover:text-white" data-home-link>Home</a>
          </li>
          <li>
            <a href="/#features" class="text-sm text-white/60 transition hover:text-white">Features</a>
          </li>
          <li>
            <a href="/#solutions" class="text-sm text-white/60 transition hover:text-white">Solutions</a>
          </li>
        </ul>
      </div>

      <div class="lg:col-span-2 text-center lg:text-left">
        <FooterHeading>Legal</FooterHeading>
        <ul class="mt-5 space-y-3 text-left">
          <li>
            <a href="#" class="text-sm text-white/60 transition hover:text-white">Privacy</a>
          </li>
          <li>
            <a href="#" class="text-sm text-white/60 transition hover:text-white">Terms</a>
          </li>
        </ul>
      </div>

      <div class="lg:col-span-3 text-center lg:text-left">
        <FooterHeading>Contact</FooterHeading>
        <ul class="mt-5 space-y-3 text-left">
          <li>
            <a
              href={`mailto:${site.contact.email}`}
              class="group inline-flex items-center gap-2.5 text-sm text-white/60 transition hover:text-white"
            >
              <Icon name="mail" class="h-4 w-4 text-white/70 transition group-hover:text-tertiary" />
              <span class="text-white/60">{site.contact.email}</span>
            </a>
          </li>
          <li class="inline-flex items-center gap-2.5 text-white/60">
            <Icon name="phone" class="h-4 w-4 text-white/70" />
            <span class="text-sm">{site.contact.phone}</span>
          </li>
        </ul>

      </div>
    </div>

    <div class="mt-16 border-t border-white/10 pt-8">
      <Copyright class="text-center text-xs text-white/70" />
    </div>
  </div>
</footer>

<script>
  const homeLinks = document.querySelectorAll<HTMLAnchorElement>("[data-home-link]");
  homeLinks.forEach((homeLink) => {
    homeLink.addEventListener("click", (e) => {
      if (window.location.pathname === "/") {
        e.preventDefault();
        window.scrollTo({ top: 0, behavior: "smooth" });
      }
    });
  });
</script>
---
import Section from "./Section.astro";
import SectionHeading from "./SectionHeading.astro";
---

<Section
  id="what"
  ariaLabel="What is MenteVior"
  class="relative overflow-hidden bg-navy-soft"
  containerClass="relative"
>
  <SectionHeading
    eyebrow="What is MenteVior"
    title="Your all-in-one ABA practice management platform"
    subtitle="MenteVior brings scheduling, session notes, data collection, service plans, supervision and billing into one integrated system — built for ABA providers."
    dark
  />

  <div class="mt-14">
    <p class="text-center text-white/60">Content coming soon.</p>
  </div>
</Section>

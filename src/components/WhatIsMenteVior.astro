---
import { Image } from "astro:assets";
import Section from "./Section.astro";
import logo from "../assets/MenteVior-logo.png";
import dashboardDesktop from "../assets/mentevior-dashboard.png";
import dashboardMobile from "../assets/mentevior-dashboard-mobile.png";
---

<Section
  id="what"
  ariaLabel="What is MenteVior"
  class="relative overflow-hidden bg-navy-soft"
  containerClass="relative"
>
  <div class="flex flex-col items-center gap-6">
    <Image src={logo} alt="MenteVior logo" width={249} height={250} format="webp" class="h-20 w-auto brightness-[10] contrast-[0.9]" />
    <h2 class="text-xl font-bold tracking-tight sm:text-2xl bg-gradient-to-r from-accent-light to-tertiary bg-clip-text text-transparent">
      What is MenteVior?
    </h2>
  </div>

  <div class="mt-14 grid gap-12 lg:grid-cols-2 lg:items-center">
    <div class="max-w-3xl text-center lg:text-left">
      <h3 class="text-3xl font-black tracking-tight text-white sm:text-4xl">
        All-in-One ABA Practice<br />
        Management Software
      </h3>
      <p class="mt-4 text-xl font-medium bg-gradient-to-r from-accent-light to-tertiary bg-clip-text text-transparent">
        Simplify Your Workflow and Focus on Delivering<br />
        Exceptional Care
      </p>
      <p class="mt-6 text-lg font-medium leading-relaxed text-white/80">
        MenteVior is an intuitive, HIPAA-secure, cloud-based platform<br />
        built for ABA providers. From scheduling and session notes to<br />
        data collection, service plans, supervision, and billing.<br />
        Everything you need in a single, accessible platform. The result:<br />
        a calmer, more compliant practice that's organized,<br />
        audit-ready, and effortless.
      </p>
    </div>

    <div class="relative flex justify-center lg:justify-end">
      <div class="macbook-frame relative z-10">
        <div class="macbook-screen">
          <div class="macbook-camera"></div>
          <div class="macbook-display">
            <Image
              src={dashboardDesktop}
              alt="MenteVior dashboard"
              width={800}
              height={500}
              format="webp"
              class="h-full w-full object-contain object-top"
            />
          </div>
        </div>
      </div>

      <div class="iphone-frame absolute -bottom-6 right-0 z-20 lg:-bottom-10 lg:-right-4">
        <div class="iphone-screen">
          <div class="iphone-island"></div>
          <div class="iphone-display">
            <Image
              src={dashboardMobile}
              alt="MenteVior mobile dashboard"
              width={300}
              height={600}
              format="webp"
              class="h-full w-full object-cover object-top"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</Section>

<style>
  .macbook-frame {
    width: 100%;
    max-width: 480px;
    animation: float 4s ease-in-out infinite;
  }

  .macbook-screen {
    background: #1a1a1a;
    border-radius: 12px 12px 0 0;
    padding: 10px 10px 0 10px;
    position: relative;
  }

  .macbook-camera {
    width: 6px;
    height: 6px;
    background: #333;
    border-radius: 50%;
    margin: 0 auto 6px;
  }

  .macbook-display {
    border-radius: 4px 4px 0 0;
    overflow: hidden;
    background: #0b1f33;
  }

  .macbook-frame::after {
    content: "";
    display: block;
    height: 12px;
    background: linear-gradient(to bottom, #2a2a2a, #1a1a1a);
    border-radius: 0 0 8px 8px;
    margin: 0 -20px;
    position: relative;
    left: -10px;
  }

  .iphone-frame {
    width: 140px;
    animation: float 4s ease-in-out infinite 1s;
  }

  .iphone-screen {
    background: #1a1a1a;
    border-radius: 28px;
    padding: 8px;
    position: relative;
  }

  .iphone-island {
    width: 40px;
    height: 10px;
    background: #000;
    border-radius: 10px;
    margin: 4px auto 6px;
  }

  .iphone-display {
    border-radius: 20px;
    overflow: hidden;
    aspect-ratio: 9 / 19.5;
    background: #0b1f33;
  }

  @keyframes float {
    0%, 100% {
      transform: translateY(0);
      filter: drop-shadow(0 10px 20px rgba(0, 0, 0, 0.3));
    }
    50% {
      transform: translateY(-8px);
      filter: drop-shadow(0 18px 30px rgba(0, 0, 0, 0.4));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .macbook-frame,
    .iphone-frame {
      animation: none;
    }
  }
</style>

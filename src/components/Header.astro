---
import { site } from "../data/site";
import BrandLockup from "./BrandLockup.astro";
import MobileMenu from "./layout/MobileMenu.astro";
import Icon from "./ui/Icon.astro";
import Button from "../ui/Button.astro";
import { icons } from "../data/icons";

interface Props {
  showDemoButton?: boolean;
}

const { showDemoButton = false } = Astro.props;
---

<header id="site-header" class="sticky top-0 z-50 w-full border-b border-[hsl(var(--color-border))] bg-white/95 backdrop-blur-xl shadow-[0_8px_24px_-4px_rgba(15,23,42,0.25)] transition-[box-shadow] duration-300 ease-in-out">
  <nav
    class="flex items-center justify-between gap-4 px-6 py-[22px] transition-[padding] duration-300 ease-in-out lg:grid lg:grid-cols-[1fr_auto_1fr] lg:items-center max-lg:pr-0"
    aria-label="Main navigation"
  >
    <div class="lg:justify-self-start lg:ml-[4.5rem]">
      <BrandLockup
        href="/"
        class="flex shrink-0 items-center gap-3 whitespace-nowrap"
        logoClass="h-10 w-auto lg:h-[3.2rem] brand-logo transition-[height] duration-300 ease-in-out"
        nameClass="h-4 w-auto lg:h-[1.25rem] brand-name transition-[height] duration-300 ease-in-out"
      />
    </div>

    <ul class="hidden items-center gap-10 lg:flex lg:justify-center">
      {
        site.nav.map((item) => (
          <li class="relative solutions-trigger">
            {item.children ? (
              <>
                <a
                  href={item.href}
                  class="inline-flex items-center gap-1.5 text-lg font-medium tracking-[-0.01em] text-[hsl(var(--color-foreground))] transition hover:text-[hsl(var(--color-primary))]"
                >
                  {item.label}
                  <svg class="h-4 w-4 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                </a>
                <div class="solutions-dropdown absolute left-1/2 top-full z-50 mt-3 w-[420px] -translate-x-[40%] rounded-xl border border-[hsl(var(--color-border))] bg-white p-2 shadow-[0_12px_40px_rgba(15,23,42,0.15)]">
                  <div class="grid grid-cols-2 gap-1">
                    {item.children.map((child) => (
                      <a
                        href={child.href}
                        class="flex items-start gap-3 rounded-lg px-3 py-2.5 text-sm font-medium text-[hsl(var(--color-foreground))] transition hover:bg-[hsl(var(--color-primary)/0.08)] hover:text-[hsl(var(--color-primary))]"
                      >
                        <svg class="mt-0.5 h-4 w-4 shrink-0 text-[hsl(var(--color-primary))]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" set:html={icons[child.icon]}/>
                        <div>
                          <div class="text-lg font-semibold">{child.label}</div>
                          {child.description && (
                            <div class="text-sm font-normal text-[hsl(var(--color-muted-foreground))] leading-snug mt-0.5">{child.description}</div>
                          )}
                        </div>
                      </a>
                    ))}
                  </div>
                </div>
              </>
            ) : (
              <a
                href={item.href}
                class="text-lg font-medium tracking-[-0.01em] text-[hsl(var(--color-foreground))] transition hover:text-[hsl(var(--color-primary))]"
              >
                {item.label}
              </a>
            )}
          </li>
        ))
      }
    </ul>

{showDemoButton ? (
      <a
        href={site.demoUrl}
        class="demo-btn-nav hidden lg:inline-flex items-center gap-2 rounded-2xl border-2 border-[hsl(210,70%,55%)] bg-[hsl(210,70%,55%)] px-5 py-2.5 text-sm font-bold text-white transition-all duration-300 hover:bg-[hsl(210,70%,55%)] hover:text-white hover:border-[hsl(210,70%,55%)] lg:justify-self-end lg:mr-[4.5rem]"
        data-demo-link
      >
        <Icon name="calendar" class="h-6 w-6 text-white" />
        Book a Demo
      </a>
    ) : (
      <a
        href="/"
        class="hidden lg:flex h-12 w-12 shrink-0 items-center justify-center rounded-lg text-[hsl(var(--color-foreground))] transition-colors hover:bg-[hsl(var(--color-muted))] lg:justify-self-end lg:mr-[4.5rem]"
        aria-label="Go to homepage"
        data-home-link
      >
        <Icon name="home" class="h-7 w-7" />
      </a>
    )}

    <button
      id="mobile-menu-button"
      type="button"
      class="relative h-10 w-10 rounded-lg text-[hsl(var(--color-foreground))] transition-colors hover:bg-[hsl(var(--color-muted))] lg:hidden"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="nav-bar" aria-hidden="true"></span>
      <span class="nav-bar" aria-hidden="true"></span>
      <span class="nav-bar" aria-hidden="true"></span>
    </button>
  </nav>
</header>
<MobileMenu />

<style>
  .nav-bar {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 22px;
    height: 2px;
    border-radius: 9999px;
    background: currentColor;
    transform: translate(-50%, -50%);
    transition:
      transform 300ms cubic-bezier(0.16, 1, 0.3, 1),
      opacity 200ms ease;
  }

  .nav-bar:nth-child(1) {
    transform: translate(-50%, -50%) translateY(-7px);
  }

  .nav-bar:nth-child(2) {
    transform: translate(-50%, -50%);
  }

  .nav-bar:nth-child(3) {
    transform: translate(-50%, -50%) translateY(7px);
  }

  #mobile-menu-button.open .nav-bar:nth-child(1) {
    transform: translate(-50%, -50%) rotate(45deg);
  }

  #mobile-menu-button.open .nav-bar:nth-child(2) {
    opacity: 0;
  }

  #mobile-menu-button.open .nav-bar:nth-child(3) {
    transform: translate(-50%, -50%) rotate(-45deg);
  }

  @media (prefers-reduced-motion: reduce) {
    #mobile-menu,
    #mobile-menu-backdrop,
    #mobile-menu .menu-link,
    .nav-bar {
      transition: none !important;
    }
  }

  #site-header.scrolled nav {
    padding-top: 0.75rem;
    padding-bottom: 0.75rem;
  }

  #site-header.scrolled nav .brand-logo {
    height: 2rem;
  }

  #site-header.scrolled nav .brand-name {
    height: 1.2rem;
  }

  #site-header.scrolled {
    box-shadow: 0 20px 48px -12px rgba(15, 23, 42, 0.35), 0 8px 32px -8px rgba(15, 23, 42, 0.25), 0 0 0 2px rgba(226, 232, 240, 0.5);
  }

  .demo-btn-nav {
    border-top: 3px solid hsl(210,80%,45%);
    border-left: 3px solid hsl(210,80%,45%);
    border-bottom: 2px solid hsl(210,70%,55%);
    border-right: 2px solid hsl(210,70%,55%);
  }

  .demo-btn-nav:hover {
    background: #0f172a;
    border-color: #0f172a;
  }

  .solutions-dropdown {
    opacity: 0;
    transform: translateY(4px) translateX(-40%);
    pointer-events: none;
    transition: opacity 200ms ease, transform 200ms ease;
  }

  .solutions-trigger:hover .solutions-dropdown {
    opacity: 1;
    transform: translateY(0) translateX(-40%);
    pointer-events: auto;
  }

  .solutions-trigger:hover > a > svg {
    transform: rotate(180deg);
  }

  .solutions-trigger::after {
    content: "";
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    height: 12px;
  }
</style>

<script>
  const siteHeader = document.getElementById("site-header");
  if (siteHeader) {
    window.addEventListener("scroll", () => {
      siteHeader.classList.toggle("scrolled", window.scrollY > 50);
    }, { passive: true });
  }

  const homeLinks = document.querySelectorAll<HTMLAnchorElement>("[data-home-link]");
  homeLinks.forEach((homeLink) => {
    homeLink.addEventListener("click", (e) => {
      if (window.location.pathname === "/") {
        e.preventDefault();
        window.scrollTo({ top: 0, behavior: "smooth" });
      }
    });
  });
</script>
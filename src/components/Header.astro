---
import { site } from "../data/site";
---

<header class="sticky top-1 z-50 px-2 pt-1">
  <nav
    class="flex items-center justify-between gap-4 rounded-b-2xl border border-navy/10 bg-white/60 px-6 py-3 shadow-lg shadow-navy/5 backdrop-blur-xl"
    aria-label="Main navigation"
  >
    <a
      href="/"
      class="flex shrink-0 items-center gap-1 whitespace-nowrap"
      aria-label={`${site.name} home`}
    >
      <img src="/MenteVior-logo.png" alt={`${site.name} logo`} class="h-16 w-auto" />
      <img src="/MenteVior-name.png" alt={site.name} class="h-8 w-auto" />
    </a>

    <ul class="hidden items-center gap-6 lg:flex">
      {
        site.nav.map((item) => (
          <li>
            <a
              href={item.href}
              class="text-sm font-medium text-navy/70 transition hover:text-primary"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <button
      id="mobile-menu-button"
      type="button"
      class="rounded-lg p-2 text-navy transition hover:bg-surface lg:hidden"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg
        id="menu-open"
        class="h-6 w-6"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
      >
        <path d="M4 7h16M4 12h16M4 17h16" />
      </svg>
      <svg
        id="menu-close"
        class="hidden h-6 w-6"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
      >
        <path d="M6 6l12 12M6 18L18 6" />
      </svg>
    </button>
  </nav>

  <div
    id="mobile-menu"
    hidden
    class="rounded-b-2xl border border-t-0 border-navy/10 bg-white/60 px-6 py-4 shadow-lg shadow-navy/5 backdrop-blur-xl lg:hidden"
  >
    <ul class="space-y-1">
      {
        site.nav.map((item) => (
          <li>
            <a
              href={item.href}
              class="block rounded-lg px-3 py-2.5 text-base font-medium text-navy/80 transition hover:bg-surface hover:text-primary"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script>
  const button = document.getElementById("mobile-menu-button");
  const menu = document.getElementById("mobile-menu");
  const openIcon = document.getElementById("menu-open");
  const closeIcon = document.getElementById("menu-close");

  button?.addEventListener("click", () => {
    const isOpen = menu ? !menu.hidden : false;
    if (menu) menu.hidden = isOpen;
    button.setAttribute("aria-expanded", String(!isOpen));
    openIcon?.classList.toggle("hidden", isOpen);
    closeIcon?.classList.toggle("hidden", !isOpen);
  });
</script>
---
import { site } from "../data/site";
import BrandLockup from "./BrandLockup.astro";
import Copyright from "./Copyright.astro";
import Icon from "./Icon.astro";
---

<header id="site-header" class="sticky top-0 z-50 w-full border-b border-navy/10 bg-white shadow-sm transition-[padding,box-shadow] duration-300 ease-in-out">
  <nav
    class="flex items-center justify-between gap-4 px-6 py-[22px] transition-[padding] duration-300 ease-in-out lg:grid lg:grid-cols-[1fr_auto_1fr] lg:items-center"
    aria-label="Main navigation"
  >
    <div class="lg:justify-self-start lg:ml-[4.5rem]">
      <BrandLockup
        href="/"
        class="flex shrink-0 items-center gap-1 whitespace-nowrap"
        logoClass="h-10 w-auto lg:h-[3.2rem] brand-logo transition-[height] duration-300 ease-in-out"
        nameClass="h-5 w-auto lg:h-[1.5rem] brand-name transition-[height] duration-300 ease-in-out"
      />
    </div>

    <ul class="hidden items-center gap-6 lg:flex lg:justify-center">
      {
        site.nav.map((item) => (
          <li>
            <a
              href={item.href}
              class="text-lg font-bold tracking-[-0.01em] text-navy transition hover:text-primary"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <a
      href="/"
      class="hidden lg:flex h-12 w-12 shrink-0 items-center justify-center rounded-lg text-navy transition-colors hover:bg-surface lg:justify-self-end lg:mr-[4.5rem]"
      aria-label="Go to homepage"
      data-home-link
    >
      <Icon name="home" class="h-7 w-7" />
    </a>

    <button
      id="mobile-menu-button"
      type="button"
      class="relative h-10 w-10 rounded-lg text-navy transition-colors hover:bg-surface lg:hidden"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="nav-bar" aria-hidden="true"></span>
      <span class="nav-bar" aria-hidden="true"></span>
      <span class="nav-bar" aria-hidden="true"></span>
    </button>
  </nav>
</header>

<div
  id="mobile-menu-backdrop"
  aria-hidden="true"
  class="fixed inset-0 z-30 bg-navy/40 opacity-0 transition-opacity duration-300 lg:hidden"
></div>

<aside
  id="mobile-menu"
  aria-hidden="true"
  class="fixed inset-y-0 left-0 z-[60] w-80 max-w-[75vw] -translate-x-full overflow-hidden bg-navy-dark transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] lg:hidden"
>
    <div class="relative flex h-full flex-col px-5 pt-20">
    <BrandLockup
      href="/"
      class="mt-8 flex items-center gap-2 px-3"
      logoClass="h-7 w-auto"
      nameClass="h-3.5 w-auto"
      inverted
    />
    <ul class="mt-8 space-y-1">
      <li>
        <a
          href="/"
          class="menu-link block rounded-lg px-3 py-2 text-sm font-bold tracking-[-0.01em] text-white/90 -translate-x-4 opacity-0 transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] hover:bg-white/5 hover:text-tertiary"
          data-home-link
          style="transition-delay: 100ms"
        >
          Home
        </a>
      </li>
      {
        site.nav.map((item, i) => (
          <li>
            <a
              href={item.href}
              class="menu-link block rounded-lg px-3 py-2 text-sm font-bold tracking-[-0.01em] text-white/90 -translate-x-4 opacity-0 transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] hover:bg-white/5 hover:text-tertiary"
              style={`transition-delay: ${100 + (i + 1) * 70}ms`}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <Copyright class="mt-auto pb-6 text-center text-xs text-white/70" />
  </div>
</aside>

<style>
  .nav-bar {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 22px;
    height: 2px;
    border-radius: 9999px;
    background: currentColor;
    transform: translate(-50%, -50%);
    transition:
      transform 300ms cubic-bezier(0.16, 1, 0.3, 1),
      opacity 200ms ease;
  }

  .nav-bar:nth-child(1) {
    transform: translate(-50%, -50%) translateY(-7px);
  }

  .nav-bar:nth-child(2) {
    transform: translate(-50%, -50%);
  }

  .nav-bar:nth-child(3) {
    transform: translate(-50%, -50%) translateY(7px);
  }

  #mobile-menu-button.open .nav-bar:nth-child(1) {
    transform: translate(-50%, -50%) rotate(45deg);
  }

  #mobile-menu-button.open .nav-bar:nth-child(2) {
    opacity: 0;
  }

  #mobile-menu-button.open .nav-bar:nth-child(3) {
    transform: translate(-50%, -50%) rotate(-45deg);
  }

  @media (prefers-reduced-motion: reduce) {
    #mobile-menu,
    #mobile-menu-backdrop,
    #mobile-menu .menu-link,
    .nav-bar {
      transition: none !important;
    }
  }

  #site-header.scrolled nav {
    padding-top: 0.75rem;
    padding-bottom: 0.75rem;
  }

  #site-header.scrolled nav .brand-logo {
    height: 2rem;
  }

  #site-header.scrolled nav .brand-name {
    height: 1.2rem;
  }

  #site-header.scrolled {
    box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1);
  }
</style>

<script>
  const button = document.getElementById("mobile-menu-button");
  const menu = document.getElementById("mobile-menu");
  const backdrop = document.getElementById("mobile-menu-backdrop");
  const links = menu ? Array.from(menu.querySelectorAll<HTMLElement>(".menu-link")) : [];

  const setOpen = (open: boolean) => {
    if (!menu || !button || !backdrop) return;

    menu.classList.toggle("-translate-x-full", !open);
    menu.classList.toggle("translate-x-0", open);
    menu.setAttribute("aria-hidden", String(!open));
    if (open) {
      menu.removeAttribute("inert");
    } else {
      menu.setAttribute("inert", "");
    }

    backdrop.classList.toggle("opacity-0", !open);
    backdrop.classList.toggle("opacity-100", open);
    backdrop.classList.toggle("pointer-events-none", !open);
    backdrop.classList.toggle("pointer-events-auto", open);
    backdrop.setAttribute("aria-hidden", String(!open));

    button.classList.toggle("open", open);
    button.setAttribute("aria-expanded", String(open));
    document.body.style.overflow = open ? "hidden" : "";

    links.forEach((link, i) => {
      link.classList.toggle("opacity-0", !open);
      link.classList.toggle("opacity-100", open);
      link.classList.toggle("-translate-x-4", !open);
      link.classList.toggle("translate-x-0", open);
      link.style.transitionDelay = open ? `${100 + i * 70}ms` : "0ms";
    });
  };

  button?.addEventListener("click", () => {
    const isOpen = menu ? !menu.classList.contains("-translate-x-full") : false;
    setOpen(!isOpen);
  });

  links.forEach((link) =>
    link.addEventListener("click", () => setOpen(false)),
  );

  const headerOffset = 96;
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  document
    .querySelectorAll<HTMLElement>("#mobile-menu a[href^='#'], header nav a[href^='#']")
    .forEach((link) =>
      link.addEventListener("click", (e) => {
        const href = link.getAttribute("href") ?? "";
        if (href.length <= 1 || !document.querySelector(href)) return;
        e.preventDefault();
        setOpen(false);
        const target = document.querySelector(href);
        if (target) {
          target.scrollIntoView({ behavior: reducedMotion ? "auto" : "smooth" });
        }
      }),
    );

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setOpen(false);
  });

  backdrop?.addEventListener("click", () => setOpen(false));

  const siteHeader = document.getElementById("site-header");
  if (siteHeader) {
    window.addEventListener("scroll", () => {
      siteHeader.classList.toggle("scrolled", window.scrollY > 50);
    }, { passive: true });
  }

  const homeLinks = document.querySelectorAll<HTMLAnchorElement>("[data-home-link]");
  homeLinks.forEach((homeLink) => {
    homeLink.addEventListener("click", (e) => {
      if (window.location.pathname === "/") {
        e.preventDefault();
        window.scrollTo({ top: 0, behavior: "smooth" });
      }
    });
  });
</script>
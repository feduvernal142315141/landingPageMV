---
import { site } from "../data/site";
import BrandLockup from "./BrandLockup.astro";
---

<header class="sticky top-1 z-50 px-2 pt-1">
  <nav
    class="flex items-center justify-between gap-4 rounded-b-2xl border border-navy/10 bg-white/70 px-6 py-3 shadow-lg shadow-navy/5 backdrop-blur-sm"
    aria-label="Main navigation"
  >
    <BrandLockup
      class="flex shrink-0 items-center gap-1 whitespace-nowrap"
      logoClass="h-12 w-auto lg:h-16"
      nameClass="h-6 w-auto lg:h-8"
    />

    <ul class="hidden items-center gap-6 lg:flex">
      {
        site.nav.map((item) => (
          <li>
            <a
              href={item.href}
              class="text-sm font-medium text-navy/70 transition hover:text-primary"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <button
      id="mobile-menu-button"
      type="button"
      class="relative h-10 w-10 rounded-lg text-navy transition-colors hover:bg-surface lg:hidden"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="nav-bar" aria-hidden="true"></span>
      <span class="nav-bar" aria-hidden="true"></span>
      <span class="nav-bar" aria-hidden="true"></span>
    </button>
  </nav>
</header>

<div
  id="mobile-menu-backdrop"
  aria-hidden="true"
  class="fixed inset-0 z-30 bg-navy/40 opacity-0 transition-opacity duration-300 lg:hidden"
></div>

<aside
  id="mobile-menu"
  aria-hidden="true"
  class="fixed inset-y-0 left-0 z-[60] w-80 max-w-[75vw] -translate-x-full overflow-hidden bg-navy-soft transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] lg:hidden"
>
    <div class="relative flex h-full flex-col px-5 pt-20">
    <BrandLockup
      class="mt-8 flex items-center gap-2 px-3"
      logoClass="h-10 w-auto"
      nameClass="h-5 w-auto"
      inverted
    />
    <ul class="mt-8 space-y-1">
      {
        site.nav.map((item, i) => (
          <li>
            <a
              href={item.href}
              class="menu-link block rounded-lg px-3 py-2 text-sm font-medium text-white/90 -translate-x-4 opacity-0 transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] hover:bg-white/5 hover:text-tertiary"
              style={`transition-delay: ${100 + i * 70}ms`}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <p class="mt-auto pb-6 text-center text-xs text-white/40">
      © {new Date().getFullYear()} {site.name}. All rights reserved.
    </p>
  </div>
</aside>

<style>
  .nav-bar {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 22px;
    height: 2px;
    border-radius: 9999px;
    background: currentColor;
    transform: translate(-50%, -50%);
    transition:
      transform 300ms cubic-bezier(0.16, 1, 0.3, 1),
      opacity 200ms ease;
  }

  .nav-bar:nth-child(1) {
    transform: translate(-50%, -50%) translateY(-7px);
  }

  .nav-bar:nth-child(2) {
    transform: translate(-50%, -50%);
  }

  .nav-bar:nth-child(3) {
    transform: translate(-50%, -50%) translateY(7px);
  }

  #mobile-menu-button.open .nav-bar:nth-child(1) {
    transform: translate(-50%, -50%) rotate(45deg);
  }

  #mobile-menu-button.open .nav-bar:nth-child(2) {
    opacity: 0;
  }

  #mobile-menu-button.open .nav-bar:nth-child(3) {
    transform: translate(-50%, -50%) rotate(-45deg);
  }

  @media (prefers-reduced-motion: reduce) {
    #mobile-menu,
    #mobile-menu-backdrop,
    #mobile-menu .menu-link,
    .nav-bar {
      transition: none !important;
    }
  }
</style>

<script>
  const button = document.getElementById("mobile-menu-button");
  const menu = document.getElementById("mobile-menu");
  const backdrop = document.getElementById("mobile-menu-backdrop");
  const links = menu ? Array.from(menu.querySelectorAll<HTMLElement>(".menu-link")) : [];

  const setOpen = (open: boolean) => {
    if (!menu || !button || !backdrop) return;

    menu.classList.toggle("-translate-x-full", !open);
    menu.classList.toggle("translate-x-0", open);
    menu.setAttribute("aria-hidden", String(!open));
    if (open) {
      menu.removeAttribute("inert");
    } else {
      menu.setAttribute("inert", "");
    }

    backdrop.classList.toggle("opacity-0", !open);
    backdrop.classList.toggle("opacity-100", open);
    backdrop.classList.toggle("pointer-events-none", !open);
    backdrop.classList.toggle("pointer-events-auto", open);
    backdrop.setAttribute("aria-hidden", String(!open));

    button.classList.toggle("open", open);
    button.setAttribute("aria-expanded", String(open));
    document.body.style.overflow = open ? "hidden" : "";

    links.forEach((link, i) => {
      link.classList.toggle("opacity-0", !open);
      link.classList.toggle("opacity-100", open);
      link.classList.toggle("-translate-x-4", !open);
      link.classList.toggle("translate-x-0", open);
      link.style.transitionDelay = open ? `${100 + i * 70}ms` : "0ms";
    });
  };

  button?.addEventListener("click", () => {
    const isOpen = menu ? !menu.classList.contains("-translate-x-full") : false;
    setOpen(!isOpen);
  });

  links.forEach((link) =>
    link.addEventListener("click", () => setOpen(false)),
  );

  const headerOffset = 96;
  const scrollToTarget = (href: string) => {
    const target = document.querySelector(href);
    if (!target) return;
    const top = target.getBoundingClientRect().top + window.scrollY - headerOffset;
    window.scrollTo({ top, behavior: "smooth" });
  };

  document
    .querySelectorAll<HTMLElement>("#mobile-menu a[href^='#'], header nav a[href^='#']")
    .forEach((link) =>
      link.addEventListener("click", (e) => {
        const href = link.getAttribute("href") ?? "";
        if (href.length <= 1 || !document.querySelector(href)) return;
        e.preventDefault();
        setOpen(false);
        setTimeout(() => scrollToTarget(href), 50);
      }),
    );

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setOpen(false);
  });

  backdrop?.addEventListener("click", () => setOpen(false));
</script>
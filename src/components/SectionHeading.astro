---
interface Props {
  eyebrow: string;
  title: string;
  subtitle?: string;
  dark?: boolean;
  class?: string;
}

const { eyebrow, title, subtitle, dark = false, class: className = "" } = Astro.props;
---

<div class={`mx-auto max-w-2xl text-center ${className}`}>
  <p class={`text-xs font-semibold uppercase tracking-widest ${dark ? "text-accent-light" : "text-primary"}`}>
    {eyebrow}
  </p>
  <h2
    class={`mt-3 text-3xl font-extrabold tracking-tight sm:text-4xl ${dark ? "text-white" : "text-navy"}`}
  >
    {title}
  </h2>
  {subtitle && (
    <p class={`mt-4 text-lg ${dark ? "text-white/70" : "text-navy/70"}`}>{subtitle}</p>
  )}
</div>
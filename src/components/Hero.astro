---
import { site } from "../data/site";
---

<section id="hero" aria-label="Hero" class="relative bg-navy lg:min-h-[960px]">
  <div aria-hidden="true" class="absolute inset-x-0 bottom-0 -top-20 lg:-top-24">
    <img
      src="/parent-highfiving-child-with-autism-1200x900.webp"
      alt=""
      class="h-full w-full object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-navy/85 via-navy/60 to-navy/25"></div>
  </div>

  <div class="relative mx-auto max-w-4xl px-6 pb-48 pt-28 text-center lg:pb-56 lg:pt-40">
    <p class="text-xs font-semibold uppercase tracking-widest text-white/80">
      Welcome to MenteVior
    </p>
    <h1 class="mt-6 text-4xl font-extrabold tracking-tight text-white sm:text-5xl lg:text-6xl">
      Your All-in-One{" "}
      <span class="bg-gradient-to-r from-accent-light via-tertiary to-white bg-clip-text text-transparent">
        ABA Practice Management
      </span>
    </h1>
    <p class="mt-5 text-sm font-medium text-white/70">
      HIPAA-compliant · Trusted by ABA providers
    </p>
  </div>
</section>

<div class="relative z-10 mx-auto -mt-80 max-w-7xl px-6">
  <div class="rounded-3xl border border-navy/5 bg-white/90 p-8 shadow-2xl shadow-navy/20 backdrop-blur-xl lg:p-12">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-xs font-semibold uppercase tracking-widest text-primary">All-in-One Platform</p>
      <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-navy sm:text-4xl">
        Built to elevate your ABA practice
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-navy/70">
        Run a calmer, more compliant ABA practice. Scheduling, session notes, data collection and
        billing — one HIPAA-secure platform, organized, audit-ready, effortless. With MenteVior,
        your clinicians can focus on what matters most: the client.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <a
          href={site.demoUrl}
          class="rounded-lg bg-gradient-to-r from-primary via-accent to-tertiary px-6 py-3 text-sm font-semibold text-white shadow-[0_8px_24px_rgba(3,126,204,0.4)] transition hover:shadow-[0_10px_28px_rgba(3,126,204,0.5)]"
        >
          Request a Demo
        </a>
        <a
          href="#features"
          class="rounded-lg border border-navy/10 bg-white px-6 py-3 text-sm font-semibold text-navy/80 transition hover:border-primary/40 hover:text-primary"
        >
          Explore Features
        </a>
      </div>
    </div>
  </div>
</div>
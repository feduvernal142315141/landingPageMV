---
import { Image } from "astro:assets";
import { site } from "../data/site";
import heroImg from "../assets/hero.webp";
import Button from "./Button.astro";
---

<section id="hero" aria-label="Hero" class="relative bg-navy-soft lg:min-h-[960px]">
  <div aria-hidden="true" class="absolute inset-x-0 bottom-0 -top-20 overflow-hidden lg:-top-24">
    <Image
      src={heroImg}
      alt=""
      width={1200}
      height={900}
      priority
      class="h-full w-full object-cover lg:h-[calc(100%+40px)] lg:object-top"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-navy-soft/90 via-navy-soft/80 to-navy-soft"></div>
  </div>

  <div class="relative mx-auto max-w-7xl px-6 pb-24 pt-28 text-left lg:pb-32 lg:pt-40">
    <h1 class="text-3xl font-black tracking-tight text-white sm:text-4xl lg:text-5xl xl:text-6xl">
      Simplify Your
      <br />
      ABA Practice
      <br />
      with{" "}
      <span class="bg-gradient-to-r from-accent-light via-tertiary to-white bg-clip-text text-transparent">
        Specialized
      </span>
      <br />
      <span class="bg-gradient-to-r from-accent-light via-tertiary to-white bg-clip-text text-transparent">
        Management Software
      </span>
    </h1>
    <p class="mt-6 max-w-2xl text-lg font-medium leading-relaxed text-white">
      Run a calmer, more compliant ABA practice. Scheduling, session notes, data collection and
      billing — one HIPAA-secure platform, organized, audit-ready, effortless.
    </p>
    <div class="mt-8 flex flex-wrap items-center gap-4">
      <Button href={site.demoUrl}>Request a Demo</Button>
      <Button href="#solutions" variant="outline">Explore Solutions</Button>
    </div>
  </div>
</section>
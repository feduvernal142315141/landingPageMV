---
import IconBadge from "./IconBadge.astro";
import Icon from "./ui/Icon.astro";

interface SolutionCategory {
  id: string;
  label: string;
  icon: string;
  description: string;
  anchor: string;
  modules: readonly { label: string; href: string; icon: string }[];
}

interface Props {
  category: SolutionCategory;
  showExplore?: boolean;
  baseUrl?: string;
  showModules?: boolean;
  showCard?: boolean;
  showWrapper?: boolean;
  isFirst?: boolean;
  isOverlapped?: boolean;
  horizontalOffset?: 'left' | 'right' | 'none';
}

const { category, showExplore = true, baseUrl = "#", showModules = true, showCard = true, showWrapper = true, isFirst = false, isOverlapped = false, horizontalOffset = 'none' } = Astro.props;
---

{showWrapper ? (
  <section id={category.anchor} class="mt-20">
    {showCard && (
      <div class={`group relative z-${isFirst ? '10' : '20'} rounded-2xl border border-[hsl(var(--color-border))] bg-white transition-all duration-300 hover:border-[hsl(var(--color-primary))] hover:shadow-xl hover:scale-[1.02] animate-float-card max-w-sm mx-auto ${isFirst ? 'mt-[80px] lg:-translate-x-[60px]' : isOverlapped ? 'mt-16 lg:mt-[-150px] lg:translate-x-[202px]' : ''}`}>
        <div class="p-5 md:p-6 lg:p-6 text-center">
          <div class="inline-flex h-16 w-16 items-center justify-center rounded-2xl bg-[hsl(var(--color-primary))]/10 mb-4 mx-auto">
            <Icon name={category.icon} class="h-8 w-8 text-[hsl(var(--color-primary))]" />
          </div>
          <h3 class="text-xl font-bold text-[hsl(var(--color-foreground))] mb-2">{category.label}</h3>
          <p class="text-sm text-[hsl(var(--color-muted-foreground))] mb-4 max-w-xs mx-auto">
            {category.description}
          </p>
          {showExplore && (
            <a
              href={`${baseUrl}#${category.anchor}`}
              class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg border-2 border-[hsl(var(--color-primary))] text-[hsl(var(--color-primary))] hover:bg-[hsl(var(--color-primary))] hover:text-[hsl(var(--color-primary-foreground))] transition-all duration-300 font-bold text-xs uppercase tracking-widest"
            >
              Explore
              <Icon name="compass" class="h-3 w-3" />
            </a>
          )}
        </div>
      </div>
    )}

    {showModules && (
      <div class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-3 justify-center max-w-5xl mx-auto">
        {category.modules.map((module, i) => {
          const isLast = i === category.modules.length - 1;
          const centerLast = isLast && category.modules.length % 3 === 1;
          return (
            <article class={`scroll-reveal slide-up rounded-2xl border border-[hsl(var(--color-border))] bg-white p-8 text-center transition hover:-translate-y-1 hover:bg-[hsl(var(--color-muted))] ${centerLast ? 'lg:col-start-2' : ''}`} style={`transition-delay: ${i * 100}ms`}>
              <IconBadge name={module.icon} class="mb-4" />
              <h4 class="font-bold text-[hsl(var(--color-foreground))]">{module.label}</h4>
            </article>
          );
        })}
      </div>
    )}
  </section>
) : (
  <>
    {showModules && (
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3 justify-center max-w-5xl mx-auto">
        {category.modules.map((module, i) => {
          const isLast = i === category.modules.length - 1;
          const centerLast = isLast && category.modules.length % 3 === 1;
          return (
            <article class={`scroll-reveal slide-up rounded-2xl border border-[hsl(var(--color-border))] bg-white p-8 text-center transition hover:-translate-y-1 hover:bg-[hsl(var(--color-muted))] ${centerLast ? 'lg:col-start-2' : ''}`} style={`transition-delay: ${i * 100}ms`}>
              <IconBadge name={module.icon} class="mb-4" />
              <h4 class="font-bold text-[hsl(var(--color-foreground))]">{module.label}</h4>
            </article>
          );
        })}
      </div>
    )}
  </>
)}
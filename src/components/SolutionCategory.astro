---
import IconBadge from "./IconBadge.astro";
import Icon from "./Icon.astro";

interface SolutionCategory {
  id: string;
  label: string;
  icon: string;
  description: string;
  anchor: string;
  modules: readonly { label: string; href: string; icon: string }[];
}

interface Props {
  category: SolutionCategory;
  showExplore?: boolean;
  baseUrl?: string;
  showModules?: boolean;
  isFirst?: boolean;
  isOverlapped?: boolean;
  isMobile?: boolean;
  horizontalOffset?: 'left' | 'right' | 'none';
}

const { category, showExplore = true, baseUrl = "#", showModules = true, isFirst = false, isOverlapped = false, isMobile = false, horizontalOffset = 'none' } = Astro.props;
---

<section id={category.anchor} class="mt-20">
  <div class={`group relative z-${isFirst ? '10' : '20'} rounded-2xl border border-white/10 bg-navy transition-all duration-300 hover:border-accent/30 hover:bg-navy hover:shadow-[0_20px_40px_-15px_rgba(0,0,0,0.4)] hover:scale-105 animate-float-card ${isOverlapped ? 'mt-[-150px]' : ''} ${isFirst ? 'mt-[80px]' : ''} ${isMobile ? 'max-w-sm mx-auto' : 'max-w-sm'} ${horizontalOffset === 'left' ? 'lg:-translate-x-[10px]' : horizontalOffset === 'right' ? 'lg:translate-x-[252px]' : ''}`}>
    <div class="p-5 md:p-6 lg:p-6 text-center">
      <div class="inline-flex h-16 w-16 items-center justify-center rounded-2xl bg-blue-400 mb-4 mx-auto">
        <Icon name={category.icon} class="h-8 w-8 text-white" />
      </div>
      <h3 class="text-xl font-black text-white mb-2">{category.label}</h3>
      <p class="text-sm text-white mb-4 max-w-xs mx-auto">
        {category.description}
      </p>
      {showExplore && (
        <a
          href={`${baseUrl}#${category.anchor}`}
          class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg border-2 border-blue-400 text-blue-400 hover:bg-blue-400 hover:text-white transition-all duration-300 font-bold text-xs uppercase tracking-widest"
        >
          Explore
          <Icon name="compass" class="h-3 w-3" />
        </a>
      )}
    </div>
  </div>

  {showModules && (
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3 justify-center max-w-5xl mx-auto">
      {category.modules.map((module) => (
        <article class="group rounded-2xl border border-white/10 bg-white/5 p-6 text-center transition hover:border-accent/50 hover:bg-white/[0.08]">
          <IconBadge name={module.icon} class="mb-4" />
          <h4 class="font-bold text-white">{module.label}</h4>
        </article>
      ))}
    </div>
  )}
</section>

<style>
  @keyframes float-card {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-8px);
    }
  }

  .animate-float-card {
    animation: float-card 4s ease-in-out infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-float-card {
      animation: none;
    }
  }
</style>
---
import { site } from "../../data/site";
import { icons } from "../../data/icons";
import Icon from "../ui/Icon.astro";
---

<div
  id="mobile-menu-backdrop"
  aria-hidden="true"
  class="fixed inset-0 z-30 bg-navy/40 opacity-0 transition-opacity duration-300 lg:hidden"
></div>

<div
  id="mobile-menu"
  aria-hidden="true"
  class="mobile-menu-panel fixed inset-x-0 z-40 overflow-y-auto border-b border-[hsl(var(--color-border))] bg-white opacity-0 pointer-events-none transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] lg:hidden"
>
  <div class="px-6 py-4">
    <nav class="flex flex-col gap-1">
      {site.nav.map((item) => (
        <div class="mobile-nav-item">
          {item.children ? (
            <>
              <button
                class="mobile-accordion-trigger flex w-full items-center justify-between rounded-xl px-4 py-3 text-left text-lg font-semibold text-[hsl(var(--color-foreground))] transition hover:bg-[hsl(var(--color-primary)/0.06)]"
                aria-expanded="false"
              >
                <span>{item.label}</span>
                <svg class="mobile-accordion-chevron h-5 w-5 shrink-0 text-[hsl(var(--color-muted-foreground))] transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
              </button>
              <div class="mobile-accordion-content hidden overflow-hidden">
                <div class="ml-4 mt-1 mb-2 space-y-1">
                  {item.children.map((child) => (
                    <a
                      href={child.href}
                      class="mobile-menu-link flex items-center gap-3 rounded-lg px-4 py-2.5 text-sm font-medium text-[hsl(var(--color-foreground))] transition hover:bg-[hsl(var(--color-primary)/0.06)] hover:text-[hsl(var(--color-primary))]"
                    >
                      <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-[hsl(var(--color-primary)/0.1)]">
                        <svg class="h-3.5 w-3.5 text-[hsl(var(--color-primary))]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" set:html={icons[child.icon]}/>
                      </div>
                      <span>{child.label}</span>
                    </a>
                  ))}
                </div>
              </div>
            </>
          ) : (
            <a
              href={item.href}
              class="mobile-menu-link block rounded-xl px-4 py-3 text-lg font-semibold text-[hsl(var(--color-foreground))] transition hover:bg-[hsl(var(--color-primary)/0.06)]"
            >
              {item.label}
            </a>
          )}
        </div>
      ))}
    </nav>

    <div class="mt-6 border-t border-[hsl(var(--color-border))] pt-6">
      <a
        href={site.demoUrl}
        class="flex items-center justify-center gap-2 rounded-xl border-2 border-[hsl(210,70%,55%)] bg-[hsl(210,70%,55%)] px-5 py-3 text-base font-bold text-white transition hover:bg-[hsl(210,70%,50%)]"
      >
        <Icon name="calendar" class="h-5 w-5" />
        Book a Demo
      </a>
    </div>
  </div>
</div>

<style>
  .mobile-menu-panel {
    box-shadow: 0 20px 60px -12px rgba(15, 23, 42, 0.15);
  }
</style>

<script>
  const button = document.getElementById("mobile-menu-button");
  const menu = document.getElementById("mobile-menu");
  const backdrop = document.getElementById("mobile-menu-backdrop");
  const links = menu ? Array.from(menu.querySelectorAll<HTMLElement>(".mobile-menu-link")) : [];

  const positionMenu = () => {
    if (!menu) return;
    const header = document.getElementById("site-header");
    if (header) {
      const h = header.getBoundingClientRect().height;
      menu.style.top = `${h}px`;
    }
  };

  const setOpen = (open: boolean) => {
    if (!menu || !button || !backdrop) return;

    positionMenu();

    if (open) {
      menu.classList.remove("opacity-0", "pointer-events-none");
      menu.classList.add("opacity-100", "pointer-events-auto");
      backdrop.classList.remove("opacity-0", "pointer-events-none");
      backdrop.classList.add("opacity-100", "pointer-events-auto");
    } else {
      menu.classList.add("opacity-0", "pointer-events-none");
      menu.classList.remove("opacity-100", "pointer-events-auto");
      backdrop.classList.add("opacity-0", "pointer-events-none");
      backdrop.classList.remove("opacity-100", "pointer-events-auto");
    }

    menu.setAttribute("aria-hidden", String(!open));
    backdrop.setAttribute("aria-hidden", String(!open));

    if (open) {
      menu.removeAttribute("inert");
    } else {
      menu.setAttribute("inert", "");
    }

    button.classList.toggle("open", open);
    button.setAttribute("aria-expanded", String(open));
    document.body.style.overflow = open ? "hidden" : "";

    links.forEach((link, i) => {
      link.style.transitionDelay = open ? `${100 + i * 50}ms` : "0ms";
    });
  };

  button?.addEventListener("click", () => {
    const isOpen = menu ? menu.classList.contains("opacity-100") : false;
    setOpen(!isOpen);
  });

  links.forEach((link) =>
    link.addEventListener("click", () => setOpen(false)),
  );

  backdrop?.addEventListener("click", () => setOpen(false));

  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  document
    .querySelectorAll<HTMLElement>("#mobile-menu a[href^='#'], header nav a[href^='#']")
    .forEach((link) =>
      link.addEventListener("click", (e) => {
        const href = link.getAttribute("href") ?? "";
        if (href.length <= 1 || !document.querySelector(href)) return;
        e.preventDefault();
        setOpen(false);
        const target = document.querySelector(href);
        if (target) {
          target.scrollIntoView({ behavior: reducedMotion ? "auto" : "smooth" });
        }
      }),
    );

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setOpen(false);
  });

  // Accordion logic
  document.querySelectorAll<HTMLElement>(".mobile-accordion-trigger").forEach((trigger) => {
    trigger.addEventListener("click", () => {
      const content = trigger.nextElementSibling as HTMLElement;
      const chevron = trigger.querySelector<HTMLElement>(".mobile-accordion-chevron");
      const isOpen = trigger.getAttribute("aria-expanded") === "true";

      trigger.setAttribute("aria-expanded", String(!isOpen));

      if (!isOpen) {
        content?.classList.remove("hidden");
        chevron?.style.setProperty("transform", "rotate(180deg)");
      } else {
        content?.classList.add("hidden");
        chevron?.style.setProperty("transform", "rotate(0deg)");
      }
    });
  });
</script>

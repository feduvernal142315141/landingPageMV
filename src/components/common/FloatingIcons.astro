---
import Icon from "../ui/Icon.astro";

interface FloatingIcon {
  name: string;
  class?: string;
  style?: string;
  animation: 'float-rotate' | 'float-drift' | 'float-pulse';
  delay?: string;
}

interface Props {
  icons?: FloatingIcon[];
  color?: 'white' | 'navy';
}

const { icons = [], color = 'white' } = Astro.props;

const defaultIcons: FloatingIcon[] = [
  { name: 'sparkles', class: 'absolute top-20 left-10 h-5 w-5', animation: 'float-rotate', delay: '-3s' },
  { name: 'compass', class: 'absolute top-32 left-20 h-5 w-5', animation: 'float-drift', delay: '-8s' },
  { name: 'layout-dashboard', class: 'absolute top-20 right-12 h-5 w-5', animation: 'float-drift', delay: '-1s' },
  { name: 'book-open', class: 'absolute top-40 right-16 h-5 w-5', animation: 'float-rotate', delay: '-12s' },
  { name: 'sparkles', class: 'absolute top-28 left-1/2 -translate-x-1/2 h-5 w-5', animation: 'float-pulse', delay: '-4s' },
  { name: 'compass', class: 'absolute top-44 left-1/2 -translate-x-1/2 h-5 w-5', animation: 'float-rotate', delay: '-11s' },
  { name: 'layout-dashboard', class: 'absolute top-16 left-1/2 -translate-x-1/2 h-5 w-5', animation: 'float-drift', delay: '-7s' },
  { name: 'calendar', class: 'absolute left-8 top-1/2 h-5 w-5', animation: 'float-pulse', delay: '-5s' },
  { name: 'layout-dashboard', class: 'absolute left-16 top-2/3 h-5 w-5', animation: 'float-rotate', delay: '-14s' },
  { name: 'compass', class: 'absolute right-10 top-1/3 h-5 w-5', animation: 'float-drift', delay: '-6s' },
  { name: 'sparkles', class: 'absolute right-14 top-3/4 h-5 w-5', animation: 'float-pulse', delay: '-9s' },
  { name: 'book-open', class: 'absolute bottom-20 left-1/3 h-5 w-5', animation: 'float-drift', delay: '-10s' },
  { name: 'calendar', class: 'absolute bottom-16 right-1/4 h-5 w-5', animation: 'float-rotate', delay: '-2s' },
];

const allIcons = icons.length > 0 ? icons : defaultIcons;
const opacity = color === 'navy' ? 'text-navy/25' : 'text-white/10';
---

<div aria-hidden="true" class="pointer-events-none absolute inset-0">
  <div class="absolute -top-24 right-1/4 h-80 w-80 rounded-full bg-accent/10 blur-3xl" />
  <div class="absolute bottom-0 left-1/4 h-72 w-72 rounded-full bg-primary/10 blur-3xl" />
  {allIcons.map((icon) => (
    <Icon
      name={icon.name}
      class={`${icon.class} ${opacity} animate-${icon.animation}`}
      style={`animation-delay: ${icon.delay ?? '0s'};`}
    />
  ))}
</div>

<style is:global>
  @keyframes float-rotate {
    0% { transform: translate(0, 0) rotate(0deg); }
    25% { transform: translate(15px, -15px) rotate(90deg); }
    50% { transform: translate(-10px, 20px) rotate(180deg); }
    75% { transform: translate(-20px, -10px) rotate(270deg); }
    100% { transform: translate(0, 0) rotate(360deg); }
  }
  @keyframes float-drift {
    0%, 100% { transform: translate(0, 0); }
    25% { transform: translate(20px, -10px); }
    50% { transform: translate(-15px, 15px); }
    75% { transform: translate(10px, 20px); }
  }
  @keyframes float-pulse {
    0%, 100% { opacity: 0.015; transform: scale(1); }
    50% { opacity: 0.04; transform: scale(1.02); }
  }
  .animate-float-rotate { animation: float-rotate 22s linear infinite; will-change: transform; }
  .animate-float-drift { animation: float-drift 18s ease-in-out infinite; will-change: transform; }
  .animate-float-pulse { animation: float-pulse 10s ease-in-out infinite; will-change: transform, opacity; }
  @media (prefers-reduced-motion: reduce) {
    .animate-float-rotate, .animate-float-drift, .animate-float-pulse { animation: none; }
  }
</style>
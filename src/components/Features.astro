---
import { features } from "../data/features";
import IconBadge from "./IconBadge.astro";
import Section from "./Section.astro";
import Icon from "./Icon.astro";
---

<Section
  id="features"
  ariaLabel="Features"
  class="relative overflow-hidden bg-navy-dark"
  containerClass="relative"
>
  <div slot="decor" aria-hidden="true" class="pointer-events-none absolute inset-0">
    <div class="absolute -top-24 right-1/4 h-80 w-80 rounded-full bg-accent/10 blur-3xl" />
    <div class="absolute bottom-0 left-1/4 h-72 w-72 rounded-full bg-primary/10 blur-3xl" />
    <!-- Floating icons (white, subtle, in empty spaces) -->
    <Icon name="sparkles" class="absolute top-20 left-10 h-5 w-5 text-white/5 animate-float-rotate" style="animation-delay: -3s;" />
    <Icon name="compass" class="absolute top-32 left-20 h-5 w-5 text-white/5 animate-float-drift" style="animation-delay: -8s;" />
    <Icon name="layout-dashboard" class="absolute top-20 right-12 h-5 w-5 text-white/5 animate-float-drift" style="animation-delay: -1s;" />
    <Icon name="book-open" class="absolute top-40 right-16 h-5 w-5 text-white/5 animate-float-rotate" style="animation-delay: -12s;" />
    <Icon name="calendar" class="absolute left-8 top-1/2 h-5 w-5 text-white/5 animate-float-pulse" style="animation-delay: -5s;" />
    <Icon name="layout-dashboard" class="absolute left-16 top-2/3 h-5 w-5 text-white/5 animate-float-rotate" style="animation-delay: -14s;" />
    <Icon name="compass" class="absolute right-10 top-1/3 h-5 w-5 text-white/5 animate-float-drift" style="animation-delay: -6s;" />
    <Icon name="sparkles" class="absolute right-14 top-3/4 h-5 w-5 text-white/5 animate-float-pulse" style="animation-delay: -9s;" />
    <Icon name="book-open" class="absolute bottom-20 left-1/3 h-5 w-5 text-white/5 animate-float-drift" style="animation-delay: -10s;" />
    <Icon name="calendar" class="absolute bottom-16 right-1/4 h-5 w-5 text-white/5 animate-float-rotate" style="animation-delay: -2s;" />
  </div>

  <!-- Floating icons keyframes -->
  <style is:global>
    @keyframes float-rotate {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }
    @keyframes float-drift {
      0%, 100% { transform: translate(0, 0) rotate(0deg); }
      25% { transform: translate(12px, -8px) rotate(2deg); }
      50% { transform: translate(-8px, 12px) rotate(-1deg); }
      75% { transform: translate(8px, -4px) rotate(1deg); }
    }
    @keyframes float-pulse {
      0%, 100% { opacity: 0.015; transform: scale(1); }
      50% { opacity: 0.04; transform: scale(1.02); }
    }
    .animate-float-rotate { animation: float-rotate 22s linear infinite; will-change: transform; }
    .animate-float-drift { animation: float-drift 18s ease-in-out infinite; will-change: transform; }
    .animate-float-pulse { animation: float-pulse 10s ease-in-out infinite; will-change: transform, opacity; }
  </style>

  <div class="scroll-reveal slide-up mx-auto max-w-2xl text-center">
    <span class="inline-flex items-center px-4 py-1.5 rounded-full bg-white/10 border border-white/20 text-xs font-bold uppercase tracking-widest text-white mb-3 block">
      Features
    </span>
    <h2 class="mt-3 text-3xl font-black tracking-tight sm:text-4xl text-blue-400">
      Smart Features To Elevate Your Care
    </h2>
    <p class="mt-4 text-lg text-white font-normal tracking-wide">
      The operating system for modern ABA practices
    </p>
  </div>

  <ul class="mt-14 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
    {
      features.map((feature, i) => (
        <li class="scroll-reveal slide-up rounded-2xl border border-white/10 bg-white/5 p-8 text-center transition hover:-translate-y-1 hover:bg-white/10" style={`transition-delay: ${i * 100}ms`}>
          <IconBadge name={feature.icon} />
          <h3 class="mt-4 text-lg font-bold text-white">{feature.title}</h3>
          <ul class="mt-4 space-y-2 text-left">
            <li class="flex items-start gap-2 text-base leading-relaxed text-white">
              <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-accent-light" />
              {feature.points[0]}
            </li>
            <li class="flex items-start gap-2 text-base leading-relaxed text-white">
              <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-accent-light" />
              {feature.points[1]}
            </li>
            {feature.points[2] && (
              <li class="flex items-start gap-2 text-base leading-relaxed text-white">
                <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-accent-light" />
                {feature.points[2]}
              </li>
            )}
          </ul>
        </li>
      ))
    }
  </ul>
</Section>

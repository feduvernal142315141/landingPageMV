---
import { features } from "../data/features";

const iconPaths: Record<string, string> = {
  calendar:
    '<rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>',
  "file-text":
    '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/>',
  "line-chart":
    '<polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/>',
  clipboard:
    '<path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/>',
  users:
    '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  dollar:
    '<line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>',
};
---

<section id="features" aria-label="Features" class="bg-white">
  <div class="mx-auto max-w-7xl px-6 py-20 lg:py-28">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-xs font-semibold uppercase tracking-widest text-primary">Features</p>
      <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-navy sm:text-4xl">
        Everything your ABA practice needs
      </h2>
      <p class="mt-4 text-lg text-navy/70">
        One integrated system for the tools your team uses every day.
      </p>
    </div>

    <ul class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        features.map((feature) => (
          <li
            class="rounded-2xl border border-navy/5 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-md"
          >
            <span
              class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-gradient-to-br from-primary to-accent text-white"
            >
              <svg
                class="h-6 w-6"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={iconPaths[feature.icon] ?? iconPaths.clipboard}
              />
            </span>
            <h3 class="mt-4 text-lg font-bold text-navy">{feature.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-navy/70">{feature.description}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
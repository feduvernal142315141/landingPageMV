---
import { testimonials } from "../data/features";
import Section from "./Section.astro";
import SectionHeading from "./SectionHeading.astro";
---

<Section
  id="testimonials"
  ariaLabel="Testimonials"
  class="relative overflow-hidden bg-navy"
  containerClass="relative"
>
  <div slot="decor" aria-hidden="true" class="pointer-events-none absolute inset-0">
    <div class="absolute -top-20 left-1/3 h-80 w-80 rounded-full bg-accent/10 blur-3xl" />
    <div class="absolute bottom-0 right-1/4 h-72 w-72 rounded-full bg-primary/10 blur-3xl" />
  </div>

  <SectionHeading eyebrow="Testimonials" title="Why practices trust MenteVior" dark />

  <div class="mt-14 grid gap-6 md:grid-cols-3">
    {
      testimonials.map((t) => (
        <figure class="flex flex-col rounded-2xl border border-white/10 bg-white/5 p-6">
          <blockquote class="flex-1 text-sm leading-relaxed text-white/70">"{t.quote}"</blockquote>
          <figcaption class="mt-6 border-t border-white/10 pt-4">
            <p class="font-semibold text-white">{t.name}</p>
            <p class="text-sm text-white/70">{t.role}</p>
          </figcaption>
        </figure>
      ))
    }
  </div>
</Section>
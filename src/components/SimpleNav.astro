---
import { site } from "../data/site";
import logo from "../assets/MenteVior-logo.png";
import Icon from "./ui/Icon.astro";
---

<nav class="fixed top-0 left-0 right-0 z-40 bg-white/80 backdrop-blur-xl border-b border-white/20">
  <div class="mx-auto max-w-7xl px-6 h-16 flex items-center justify-between">
    <a href="/" class="flex items-center" aria-label={site.name}>
      <img src={logo.src} alt={site.name} class="h-8 w-auto" />
    </a>
    <a href="/" class="p-2 rounded-lg hover:bg-white/20 transition-colors" aria-label="Go to homepage">
      <Icon name="layout-dashboard" class="h-5 w-5 text-navy" />
    </a>
  </div>
</nav>


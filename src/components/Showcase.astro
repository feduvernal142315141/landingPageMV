---
import { showcase } from "../data/features";
import Screenshot from "./Screenshot.astro";
import Section from "./Section.astro";
import SectionHeading from "./SectionHeading.astro";
---

<Section id="showcase" ariaLabel="Product showcase" class="bg-surface">
  <SectionHeading eyebrow="Product in action" title="See what MenteVior can do for you" />

  <div class="mt-14 space-y-20">
    {
      showcase.map((item, index) => (
        <div id={item.id} class="grid items-center gap-10 lg:grid-cols-2">
          <div class={index % 2 === 1 ? "lg:order-2" : ""}>
            <h3 class="text-2xl font-bold text-navy">{item.title}</h3>
            <p class="mt-3 leading-relaxed text-navy/70">{item.description}</p>
          </div>
          <Screenshot src={item.screenshot} alt={item.alt} label={`${item.title} — screenshot coming soon`} />
        </div>
      ))
    }
  </div>
</Section>
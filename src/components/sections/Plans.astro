---
import { pricingPlans } from "../../data/pricing";
import { site } from "../../data/site";
import Section from "./Section.astro";
import Button from "../ui/Button.astro";
---

<Section
  id="pricing"
  ariaLabel="Pricing Plans"
  class="relative overflow-hidden bg-[hsl(var(--color-primary))]"
  containerClass="relative"
>
  <div class="mx-auto max-w-7xl px-6 py-20 lg:py-28">
    <div class="scroll-reveal slide-up text-center mb-16">
      <span class="inline-flex items-center px-4 py-1.5 rounded-full bg-[hsl(var(--color-primary-foreground))]/10 border border-[hsl(var(--color-primary-foreground))]/20 text-sm font-bold uppercase tracking-widest text-[hsl(var(--color-primary-foreground))] mb-3 block">
        Pricing
      </span>
      <h2 class="text-3xl font-black tracking-tight text-[hsl(var(--color-primary-foreground))] sm:text-4xl">
        Plans that grow with your practice
      </h2>
      <p class="mt-4 text-lg text-[hsl(var(--color-primary-foreground))] font-normal tracking-wide">
        Pricing is tailored to your practice size and services.
      </p>
    </div>

    <div class="grid gap-8 md:grid-cols-3">
      {pricingPlans.map((plan, index) => (
        <article class="scroll-reveal slide-up relative rounded-2xl bg-[hsl(var(--color-bg-warm))] p-8 text-center transition-all duration-300 hover:-translate-y-1 hover:shadow-xl" style={`transition-delay: ${index * 100}ms`}>
          {plan.popular && (
            <div class="absolute -top-3 left-1/2 -translate-x-1/2">
              <span class="inline-flex items-center px-3 py-1 rounded-full bg-[hsl(var(--color-primary))] text-sm font-bold uppercase tracking-widest text-[hsl(var(--color-primary-foreground))]">
                Most Popular
              </span>
            </div>
          )}
          <div class="text-center mb-6">
            <h3 class="text-xl font-black text-[hsl(var(--color-foreground))]">{plan.name}</h3>
            <p class="mt-2 text-sm text-[hsl(var(--color-muted-foreground))]">{plan.audience}</p>
          </div>
          <div class="mb-8">
            <span class="text-4xl font-black text-[hsl(var(--color-foreground))]">{plan.price}</span>
          </div>
          <ul class="space-y-4 text-left mb-8">
            {plan.features.map((feature) => (
              <li class="flex items-start gap-3 text-left">
                <span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-[hsl(var(--color-primary))]" />
                <span class="text-base leading-relaxed text-[hsl(var(--color-muted-foreground))]">{feature}</span>
              </li>
            ))}
          </ul>
          <Button
            href={plan.ctaHref}
            variant={plan.popular ? "cta-primary" : "cta-secondary"}
            class="w-full"
          >
            {plan.ctaText}
          </Button>
        </article>
      ))}
    </div>

    <p class="mt-12 text-center text-sm text-[hsl(var(--color-primary-foreground))/70]">
      Pricing is tailored to your practice size and services across three plans — Basic, Pro and Enterprise.{' '}
      <a href={site.demoUrl} class="font-semibold underline hover:underline-offset-2">
        Book a demo
      </a>
      and we'll scope it with your numbers; there's no setup fee to evaluate.
    </p>
  </div>
</Section>
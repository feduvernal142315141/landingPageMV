---
import { Image } from "astro:assets";
import Section from "./Section.astro";
import logo from "../../assets/MenteVior-logo.png";
import dashboardDesktop from "../../assets/mentevior-dashboard.png";
---

<Section
  id="what"
  ariaLabel="What is MenteVior"
  class="relative overflow-hidden bg-[hsl(var(--color-bg-warm-half))]"
  containerClass="relative"
>
  <div class="scroll-reveal slide-up flex flex-col items-center gap-6">
    <Image src={logo} alt="MenteVior logo" width={249} height={250} format="webp" class="h-20 w-auto" />
    <h2 class="text-[2.025rem] font-bold tracking-tight sm:text-[2.7rem] text-[hsl(var(--color-foreground))]">
      What is MenteVior?
    </h2>
  </div>

  <div class="mt-14 grid gap-12 lg:grid-cols-2 lg:items-center">
    <div class="scroll-reveal slide-left max-w-3xl text-center lg:text-left">
      <h3 class="text-3xl font-black tracking-tight text-[hsl(var(--color-foreground))] sm:text-4xl">
        All-in-One ABA Practice<br />
        Management Software
      </h3>
      <p class="mt-4 text-2xl font-medium text-[hsl(var(--color-primary))]">
        <span class="lg:hidden">
          Simplify Your Workflow and Focus on<br />
          Delivering Exceptional Care
        </span>
        <span class="hidden lg:block">
          Simplify Your Workflow and Focus on Delivering<br />
          Exceptional Care
        </span>
      </p>
      <p class="mt-6 text-left text-lg font-medium leading-relaxed text-[hsl(var(--color-muted-foreground))]">
        <span class="lg:hidden">
          MenteVior is an intuitive, HIPAA-secure,<br />
          cloud-based platform built for ABA providers. From scheduling and session notes to data collection, service plans, supervision, and billing. Everything you need in a single, accessible platform. The result:<br />
          a calmer, more compliant practice that's organized, audit-ready, and effortless.
        </span>
        <span class="hidden lg:block">
          MenteVior is an intuitive, HIPAA-secure, cloud-based platform<br />
          built for ABA providers. From scheduling and session notes to<br />
          data collection, service plans, supervision, and billing.<br />
          Everything you need in a single, accessible platform. The result:<br />
          a calmer, more compliant practice that's organized,<br />
          audit-ready, and effortless.
        </span>
      </p>
    </div>

    <div class="scroll-reveal slide-right relative flex justify-center lg:justify-end">
      <div class="monitor-frame relative z-10">
        <div class="monitor-screen">
          <div class="monitor-display">
            <Image
              src={dashboardDesktop}
              alt="MenteVior dashboard"
              width={800}
              height={500}
              format="webp"
              class="h-full w-full object-contain object-top"
            />
          </div>
        </div>
        <div class="monitor-stand"></div>
        <div class="monitor-base"></div>
      </div>
    </div>
  </div>
</Section>

<style>
  .monitor-frame {
    width: 100%;
    max-width: 432px;
    animation: float 4s ease-in-out infinite;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
  }

  .monitor-screen {
    width: 100%;
    aspect-ratio: 16 / 9.5;
    background: hsl(var(--color-foreground));
    border-radius: 8px 8px 4px 4px;
    padding: 6px;
    box-shadow: 
      inset 0 1px 0 hsl(0 0% 100% / 0.1),
      0 4px 24px -4px rgba(15, 23, 42, 0.4),
      0 0 0 1px hsl(var(--color-foreground) / 0.8);
    position: relative;
  }

  .monitor-screen::before {
    content: "";
    position: absolute;
    top: 8px;
    left: 50%;
    transform: translateX(-50%);
    width: 60px;
    height: 4px;
    background: hsl(var(--color-foreground) / 0.6);
    border-radius: 2px;
  }

  .monitor-display {
    width: 100%;
    height: 100%;
    border-radius: 4px;
    overflow: hidden;
    background: hsl(var(--color-bg-primary));
  }

  .monitor-stand {
    width: 8px;
    height: 32px;
    background: linear-gradient(180deg, hsl(210 10% 45%) 0%, hsl(210 10% 35%) 100%);
    border-radius: 2px;
    margin-top: -2px;
    box-shadow: 
      inset 0 1px 0 hsl(0 0% 100% / 0.1),
      0 2px 8px rgba(15, 23, 42, 0.2);
  }

  .monitor-base {
    width: 120px;
    height: 10px;
    background: linear-gradient(180deg, hsl(210 10% 50%) 0%, hsl(210 10% 40%) 100%);
    border-radius: 5px;
    box-shadow: 
      inset 0 1px 0 hsl(0 0% 100% / 0.15),
      0 4px 16px rgba(15, 23, 42, 0.15),
      0 0 0 1px hsl(210 10% 30%);
  }

  @keyframes float {
    0%, 100% {
      transform: translateY(0);
      filter: drop-shadow(0 10px 20px rgba(15,23,42,0.1));
    }
    50% {
      transform: translateY(-8px);
      filter: drop-shadow(0 18px 30px rgba(15,23,42,0.15));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .monitor-frame {
      animation: none;
    }
  }
</style>
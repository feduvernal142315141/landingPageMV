---
import { Image } from "astro:assets";
import Section from "./Section.astro";
import logo from "../../assets/MenteVior-logo.png";
import dashboardDesktop from "../../assets/mentevior-dashboard.png";
import Icon from "../ui/Icon.astro";
---

<Section
  id="what"
  ariaLabel="What is MenteVior"
  class="relative overflow-hidden bg-[hsl(var(--color-bg-warm-half))]"
  containerClass="relative"
>
  <div slot="decor" aria-hidden="true" class="pointer-events-none absolute inset-0 overflow-hidden">
    <!-- Icon 1: layout-dashboard (Command center) - LEFT -->
    <Icon name="layout-dashboard" class="absolute top-[8%] left-[5%] h-8 w-8 text-[hsl(var(--color-primary))] opacity-25 animate-float-drift" style="animation-delay: -2s;" />
    <!-- Icon 2: calendar (Scheduling) - RIGHT -->
    <Icon name="calendar" class="absolute top-[12%] right-[2%] h-7 w-7 text-[hsl(var(--color-primary))] opacity-25 animate-float-pulse" style="animation-delay: -4s;" />
    <!-- Icon 3: file-text (Session notes/docs) - LEFT -->
    <Icon name="file-text" class="absolute top-[20%] left-[3%] h-7 w-7 text-[hsl(var(--color-primary))] opacity-25 animate-float-rotate" style="animation-delay: -6s;" />
    <!-- Icon 4: chart-line (Progress/data) - RIGHT -->
    <Icon name="chart-line" class="absolute top-[25%] right-[4%] h-7 w-7 text-[hsl(var(--color-primary))] opacity-25 animate-float-drift" style="animation-delay: -8s;" />
    <!-- Icon 5: users (Team/collaboration) - LEFT -->
    <Icon name="users" class="absolute top-[35%] left-[2%] h-8 w-8 text-[hsl(var(--color-primary))] opacity-25 animate-float-pulse" style="animation-delay: -10s;" />
    <!-- Icon 6: shield (Compliance/security) - RIGHT -->
    <Icon name="shield" class="absolute top-[45%] right-[1%] h-8 w-8 text-[hsl(var(--color-primary))] opacity-25 animate-float-rotate" style="animation-delay: -12s;" />
    <!-- Icon 7: credit-card (Billing) - LEFT -->
    <Icon name="credit-card" class="absolute top-[55%] left-[8%] h-7 w-7 text-[hsl(var(--color-primary))] opacity-25 animate-float-drift" style="animation-delay: -14s;" />
    <!-- Icon 8: book-open (Supervision/plans) - RIGHT -->
    <Icon name="book-open" class="absolute top-[65%] right-[3%] h-8 w-8 text-[hsl(var(--color-primary))] opacity-25 animate-float-pulse" style="animation-delay: -16s;" />
    <!-- Icon 9: database (Data collection) - LEFT -->
    <Icon name="database" class="absolute top-[75%] left-[4%] h-8 w-8 text-[hsl(var(--color-primary))] opacity-25 animate-float-rotate" style="animation-delay: -18s;" />
    <!-- Icon 10: check-circle (Audit-ready) - RIGHT -->
    <Icon name="check-circle" class="absolute top-[85%] right-[1%] h-7 w-7 text-[hsl(var(--color-primary))] opacity-25 animate-float-drift" style="animation-delay: -20s;" />
  </div>

  <div class="scroll-reveal slide-up flex flex-col items-center gap-6">
    <Image src={logo} alt="MenteVior logo" width={249} height={250} format="webp" class="h-20 w-auto" />
    <h2 class="text-[2.025rem] font-bold tracking-tight sm:text-[2.7rem] text-[hsl(var(--color-foreground))]">
      Why MenteVior?
    </h2>
  </div>

  <div class="mt-14 grid gap-12 lg:grid-cols-2 lg:items-center">
    <div class="scroll-reveal slide-left max-w-3xl text-center lg:text-left">
      <h3 class="text-3xl font-black tracking-tight text-[hsl(var(--color-foreground))] sm:text-4xl">
        All-in-One ABA Practice<br />
        Management Software
      </h3>
      <p class="mt-4 text-2xl font-medium text-[hsl(var(--color-primary))]">
        <span class="lg:hidden">
          Simplify Your Workflow and Focus on<br />
          Delivering Exceptional Care
        </span>
        <span class="hidden lg:block">
          Simplify Your Workflow and Focus on Delivering<br />
          Exceptional Care
        </span>
      </p>
      <p class="mt-6 text-left text-lg font-medium leading-relaxed text-[hsl(var(--color-muted-foreground))]">
        <span class="lg:hidden">
          Every week, your team re-enters the same session data into<br />
          two or three systems. Hours lost to re-entry that could go<br />
          toward clients. Documentation gaps stay invisible until the<br />
          claim comes back denied. Authorizations expire quietly, and<br />
          the sessions delivered against them don't get paid.<br />
          MenteVior eliminates all of it — one HIPAA-secure platform<br />
          that connects scheduling, session notes, data collection,<br />
          service plans, supervision, and billing into a single record.<br />
          Your practice stays organized, compliant, and audit-ready.
        </span>
        <span class="hidden lg:block">
          Every week, your team re-enters the same session data into<br />
          two or three systems. Hours lost to re-entry that could go<br />
          toward clients. Documentation gaps stay invisible until the<br />
          claim comes back denied. Authorizations expire quietly, and<br />
          the sessions delivered against them don't get paid.<br />
          MenteVior eliminates all of it — one HIPAA-secure platform<br />
          that connects scheduling, session notes, data collection,<br />
          service plans, supervision, and billing into a single record.<br />
          Your practice stays organized, compliant, and audit-ready.
        </span>
      </p>
    </div>

    <div class="scroll-reveal slide-right flex justify-center">
      <div class="monitor-frame relative z-10">
        <div class="monitor-screen">
          <div class="monitor-display">
            <Image
              src={dashboardDesktop}
              alt="MenteVior dashboard"
              width={800}
              height={500}
              format="webp"
              class="h-full w-full object-contain object-top"
            />
          </div>
        </div>
        <div class="monitor-stand"></div>
        <div class="monitor-base"></div>
      </div>
    </div>
  </div>

  <div class="scroll-reveal slide-up mt-14 flex justify-center">
    <ul class="flex flex-col md:flex-row gap-6 text-left text-lg font-medium leading-relaxed text-[hsl(var(--color-muted-foreground))] max-w-5xl">
      <li class="flex-1 flex items-start gap-3 rounded-xl bg-[hsl(var(--color-primary)/0.08)] p-4">
        <svg class="mt-1.5 h-5 w-5 shrink-0 text-[hsl(var(--color-primary))]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        <span class="whitespace-nowrap"><strong class="text-[hsl(var(--color-foreground))]">Five systems replaced by one</strong></span>
      </li>
      <li class="flex-1 flex items-start gap-3 rounded-xl bg-[hsl(var(--color-primary)/0.08)] p-4">
        <svg class="mt-1.5 h-5 w-5 shrink-0 text-[hsl(var(--color-primary))]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        <span class="whitespace-nowrap"><strong class="text-[hsl(var(--color-foreground))]">Denials prevented, not reacted to</strong></span>
      </li>
      <li class="flex-1 flex items-start gap-3 rounded-xl bg-[hsl(var(--color-primary)/0.08)] p-4">
        <svg class="mt-1.5 h-5 w-5 shrink-0 text-[hsl(var(--color-primary))]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        <span class="whitespace-nowrap"><strong class="text-[hsl(var(--color-foreground))]">Zero re-entry, No wasted hours</strong></span>
      </li>
    </ul>
  </div>
</Section>

<style>
  .monitor-frame {
    width: 100%;
    max-width: 432px;
    animation: float 3s ease-in-out infinite;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
  }

  .monitor-screen {
    width: 100%;
    aspect-ratio: 16 / 9.5;
    background: hsl(var(--color-foreground));
    border-radius: 12px;
    padding: 12px;
    box-shadow: 
      inset 0 1px 0 hsl(0 0% 100% / 0.1),
      0 4px 24px -4px rgba(15, 23, 42, 0.4),
      0 0 0 1px hsl(var(--color-foreground) / 0.8);
    position: relative;
  }

  .monitor-screen::before {
    content: "";
    position: absolute;
    top: 8px;
    left: 50%;
    transform: translateX(-50%);
    width: 60px;
    height: 4px;
    background: hsl(var(--color-foreground) / 0.6);
    border-radius: 2px;
  }

  .monitor-display {
    width: 100%;
    height: 100%;
    border-radius: 12px;
    overflow: hidden;
    background: hsl(var(--color-bg-primary));
  }

  .monitor-stand {
    width: 8px;
    height: 32px;
    background: linear-gradient(180deg, hsl(210 10% 45%) 0%, hsl(210 10% 35%) 100%);
    border-radius: 2px;
    margin-top: -2px;
    box-shadow: 
      inset 0 1px 0 hsl(0 0% 100% / 0.1),
      0 2px 8px rgba(15, 23, 42, 0.2);
  }

  .monitor-base {
    width: 120px;
    height: 10px;
    background: linear-gradient(180deg, hsl(210 10% 50%) 0%, hsl(210 10% 40%) 100%);
    border-radius: 5px;
    box-shadow: 
      inset 0 1px 0 hsl(0 0% 100% / 0.15),
      0 4px 16px rgba(15, 23, 42, 0.15),
      0 0 0 1px hsl(210 10% 30%);
  }

  @keyframes float {
    0%, 100% {
      transform: translateY(0);
      filter: drop-shadow(0 10px 20px rgba(15,23,42,0.1));
    }
    50% {
      transform: translateY(-28px);
      filter: drop-shadow(0 30px 55px rgba(15,23,42,0.22));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .monitor-frame {
      animation: none;
    }
  }
</style>
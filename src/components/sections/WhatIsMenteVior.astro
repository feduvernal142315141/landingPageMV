---
import { Image } from "astro:assets";
import Section from "./Section.astro";
import logo from "../../assets/MenteVior-logo.png";
import dashboardDesktop from "../../assets/mentevior-dashboard.png";
import Icon from "../ui/Icon.astro";
---

<Section
  id="what"
  ariaLabel="What is MenteVior"
  class="relative overflow-hidden bg-[hsl(var(--color-bg-warm-half))]"
  containerClass="relative"
>
  <div class="scroll-reveal slide-up flex flex-col items-center gap-6">
    <Image src={logo} alt="MenteVior logo" width={249} height={250} format="webp" class="h-20 w-auto" />
    <h2 class="text-[2.025rem] font-bold tracking-tight sm:text-[2.7rem] text-[hsl(var(--color-foreground))]">
      What is MenteVior?
    </h2>
  </div>

  <div class="mt-14 grid gap-12 lg:grid-cols-2 lg:items-center">
    <div class="scroll-reveal slide-left max-w-3xl text-center lg:text-left">
      <h3 class="text-3xl font-black tracking-tight text-[hsl(var(--color-foreground))] sm:text-4xl">
        All-in-One ABA Practice<br />
        Management Software
      </h3>
      <p class="mt-4 text-2xl font-medium text-[hsl(var(--color-primary))]">
        <span class="lg:hidden">
          Simplify Your Workflow and Focus on<br />
          Delivering Exceptional Care
        </span>
        <span class="hidden lg:block">
          Simplify Your Workflow and Focus on Delivering<br />
          Exceptional Care
        </span>
      </p>
      <p class="mt-6 text-left text-lg font-medium leading-relaxed text-[hsl(var(--color-muted-foreground))]">
        <span class="lg:hidden">
          MenteVior is an intuitive, HIPAA-secure,<br />
          cloud-based platform built for ABA providers. From scheduling and session notes to data collection, service plans, supervision, and billing. Everything you need in a single, accessible platform. The result:<br />
          a calmer, more compliant practice that's organized, audit-ready, and effortless.
        </span>
        <span class="hidden lg:block">
          MenteVior is an intuitive, HIPAA-secure, cloud-based platform<br />
          built for ABA providers. From scheduling and session notes to<br />
          data collection, service plans, supervision, and billing.<br />
          Everything you need in a single, accessible platform. The result:<br />
          a calmer, more compliant practice that's organized,<br />
          audit-ready, and effortless.
        </span>
      </p>
    </div>

    <div class="scroll-reveal slide-right relative flex justify-center lg:justify-end">
      <div class="macbook-frame relative z-10">
        <div class="macbook-screen">
          <div class="macbook-camera"></div>
          <div class="macbook-display">
            <Image
              src={dashboardDesktop}
              alt="MenteVior dashboard"
              width={800}
              height={500}
              format="webp"
              class="h-full w-full object-contain object-top"
            />
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Floating icons (Clinicia-style scattered) -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 overflow-hidden">
    <!-- Icon 1: layout-dashboard (Command center) -->
    <Icon name="layout-dashboard" class="absolute top-[10%] left-[5%] h-8 w-8 text-[hsl(var(--color-primary))] opacity-10 animate-float-drift" style="animation-delay: -2s;" />
    <!-- Icon 2: calendar (Scheduling) -->
    <Icon name="calendar" class="absolute top-[15%] right-[8%] h-7 w-7 text-[hsl(var(--color-primary))] opacity-10 animate-float-pulse" style="animation-delay: -4s;" />
    <!-- Icon 3: file-text (Session notes/docs) -->
    <Icon name="file-text" class="absolute top-[25%] left-[3%] h-8 w-8 text-[hsl(var(--color-primary))] opacity-10 animate-float-rotate" style="animation-delay: -6s;" />
    <!-- Icon 4: chart-line (Progress/data) -->
    <Icon name="chart-line" class="absolute top-[30%] right-[15%] h-7 w-7 text-[hsl(var(--color-primary))] opacity-10 animate-float-drift" style="animation-delay: -8s;" />
    <!-- Icon 5: users (Team/collaboration) -->
    <Icon name="users" class="absolute top-[40%] left-[2%] h-9 w-9 text-[hsl(var(--color-primary))] opacity-10 animate-float-pulse" style="animation-delay: -10s;" />
    <!-- Icon 6: shield (Compliance/security) -->
    <Icon name="shield" class="absolute top-[50%] right-[5%] h-8 w-8 text-[hsl(var(--color-primary))] opacity-10 animate-float-rotate" style="animation-delay: -12s;" />
    <!-- Icon 7: credit-card (Billing) -->
    <Icon name="credit-card" class="absolute top-[60%] left-[8%] h-7 w-7 text-[hsl(var(--color-primary))] opacity-10 animate-float-drift" style="animation-delay: -14s;" />
    <!-- Icon 8: book-open (Supervision/plans) -->
    <Icon name="book-open" class="absolute top-[70%] right-[12%] h-8 w-8 text-[hsl(var(--color-primary))] opacity-10 animate-float-pulse" style="animation-delay: -16s;" />
    <!-- Icon 9: database (Data collection) -->
    <Icon name="database" class="absolute top-[80%] left-[4%] h-9 w-9 text-[hsl(var(--color-primary))] opacity-10 animate-float-rotate" style="animation-delay: -18s;" />
    <!-- Icon 10: check-circle (Audit-ready) -->
    <Icon name="check-circle" class="absolute top-[88%] right-[3%] h-7 w-7 text-[hsl(var(--color-primary))] opacity-10 animate-float-drift" style="animation-delay: -20s;" />
  </div>
</Section>

<style>
  .macbook-frame {
    width: 100%;
    max-width: 480px;
    animation: float 4s ease-in-out infinite;
    border: 2px solid hsl(var(--color-foreground));
    border-radius: 16px 16px 4px 4px;
    background: white;
    box-shadow: 0 28px 72px -16px rgba(15,23,42,0.08), 0 10px 32px -10px rgba(15,23,42,0.06), 0 0 0 1px rgba(226,232,240,0.45);
    overflow: hidden;
  }

  .macbook-screen {
    border-radius: 14px 14px 0 0;
    padding: 10px 10px 0 10px;
    position: relative;
    background: hsl(var(--color-bg-primary));
  }

  .macbook-camera {
    width: 6px;
    height: 6px;
    background: hsl(var(--color-muted-foreground));
    border-radius: 50%;
    margin: 0 auto 6px;
  }

  .macbook-display {
    border-radius: 4px 4px 0 0;
    overflow: hidden;
    background: hsl(var(--color-bg-primary));
  }

  .macbook-frame::after {
    content: "";
    display: block;
    height: 12px;
    background: hsl(var(--color-muted));
    border-radius: 0 0 8px 8px;
    margin: 0 -20px;
    position: relative;
    left: -10px;
  }

  @keyframes float {
    0%, 100% {
      transform: translateY(0);
      filter: drop-shadow(0 10px 20px rgba(15,23,42,0.1));
    }
    50% {
      transform: translateY(-8px);
      filter: drop-shadow(0 18px 30px rgba(15,23,42,0.15));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .macbook-frame {
      animation: none;
    }
  }
</style>
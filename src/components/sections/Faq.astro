---
import { site } from "../../data/site";
import { faqs } from "../../data/faq";
import Section from "./Section.astro";
---

<Section
  id="faq"
  ariaLabel="Frequently Asked Questions"
  class="bg-[hsl(var(--color-bg-warm-half))] scroll-mt-[-20px]"
  containerClass="relative"
>
  <div class="mx-auto max-w-7xl px-6 py-20 lg:py-28">
    <div class="text-center mb-16">
      <span class="scroll-reveal slide-up inline-flex items-center px-4 py-1.5 rounded-full bg-[hsl(var(--color-primary))]/10 border border-[hsl(var(--color-primary))]/20 text-sm font-bold uppercase tracking-widest text-[hsl(var(--color-primary))] mb-3 block" style="transition-delay: 0ms;">
        FAQ
      </span>
      <h2 class="scroll-reveal slide-up text-3xl font-black tracking-tight text-[hsl(var(--color-foreground))] sm:text-4xl" style="transition-delay: 100ms;">
        Questions, answered
      </h2>
    </div>

    <div class="mx-auto max-w-3xl">
      {faqs.map((faq, index) => (
        <div class="scroll-reveal slide-right faq-item border-b border-[hsl(var(--color-border))]" style={`transition-delay: ${index * 150}ms;`}>
          <button
            class="faq-button w-full flex items-center justify-between py-5 text-left transition-colors hover:bg-[hsl(var(--color-primary)/0.05)] px-4 rounded-lg"
            data-index={index}
          >
            <span class="text-lg font-semibold text-[hsl(var(--color-foreground))] pr-4">{faq.question}</span>
            <svg class="faq-chevron h-5 w-5 shrink-0 text-[hsl(var(--color-primary))] transition-transform duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9" />
            </svg>
          </button>
          <div class="faq-answer overflow-hidden transition-all duration-300" style="max-height: 0;">
            <p class="px-4 pb-5 text-lg text-[hsl(var(--color-muted-foreground))] leading-relaxed">
              {faq.answer}
            </p>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-16 text-center">
      <p class="text-lg text-[hsl(var(--color-muted-foreground))]">
        Something else?&nbsp;
        <a href={site.demoUrl} class="text-[hsl(var(--color-primary))] font-semibold hover:underline">
          Ask us in a demo
        </a>
        .&nbsp;Prefer email?&nbsp;
        <a href={`mailto:${site.contact.email}`} class="text-[hsl(var(--color-primary))] font-semibold hover:underline">
          We'd love to hear from you
        </a>
      </p>
    </div>
  </div>
</Section>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const buttons = document.querySelectorAll(".faq-button");

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        const answer = button.parentElement?.querySelector(".faq-answer") as HTMLElement;
        const chevron = button.querySelector(".faq-chevron") as HTMLElement;
        const isOpen = answer.style.maxHeight !== "0px" && answer.style.maxHeight !== "";

        if (isOpen) {
          answer.style.maxHeight = "0px";
          chevron.style.transform = "rotate(0deg)";
        } else {
          answer.style.maxHeight = answer.scrollHeight + "px";
          chevron.style.transform = "rotate(180deg)";
        }
      });
    });
  });
</script>

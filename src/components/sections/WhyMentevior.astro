---
import { whys } from "../../data/solutions";
import IconBadge from "../IconBadge.astro";
import Section from "./Section.astro";
---

<Section
  id="why"
  ariaLabel="Why MenteVior"
  class="relative overflow-hidden bg-[hsl(var(--color-bg-primary))] bg-grid-pattern"
  containerClass="relative"
>
  <div class="scroll-reveal slide-up flex flex-col items-center">
    <h2 class="text-3xl font-black tracking-tight text-[hsl(var(--color-foreground))] sm:text-4xl">
      Why Choose MenteVior?
    </h2>
  </div>
  <div class="scroll-reveal slide-up mt-6 mx-auto max-w-2xl text-center">
    <h3 class="text-lg text-[hsl(var(--color-primary))] font-normal tracking-wide">
      The reasons our clients <span class="font-black">stay with us</span>
    </h3>
  </div>

  <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {
      whys.map((item, i) => (
        <div class="scroll-reveal slide-up group flex flex-col items-center rounded-2xl border border-[hsl(var(--color-border))] bg-white p-6 text-center transition-all duration-300 hover:-translate-y-1.5 hover:border-[hsl(var(--color-primary))] hover:shadow-lg" style={`transition-delay: ${i * 100}ms`}>
          <IconBadge name={item.icon} class="transition-transform duration-300 group-hover:scale-110" />
          <h3 class="mt-4 text-lg font-bold text-[hsl(var(--color-foreground))]">{item.title}</h3>
        </div>
      ))
    }
  </div>
</Section>
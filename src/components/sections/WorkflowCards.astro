---
const cards = [
  {
    title: "Document",
    body: "Create clinical records once. Treatment plans, assessments, and reports flow from the same entry.",
    href: "/solutions#document",
  },
  {
    title: "Collect",
    body: "Capture data in real time. Live graphs and trend analysis update as you record.",
    href: "/solutions#collect",
  },
  {
    title: "Operate",
    body: "Schedule, authorize, and bill from one connected workflow.",
    href: "/solutions#operate",
  },
  {
    title: "Comply",
    body: "Supervision and compliance tracked automatically. Every record audit-ready.",
    href: "/solutions#comply",
  },
  {
    title: "Configure",
    body: "Set rules once. Permissions, plans, and templates enforced across the entire platform.",
    href: "/solutions#configure",
  },
];
---

<div class="mt-16">
  <!-- Desktop: horizontal row with arrows -->
  <div class="hidden lg:flex items-center justify-center gap-4">
    {cards.map((card, index) => (
      <div class="flex items-center gap-3">
        <article class="flex flex-col items-center text-center rounded-2xl bg-white/80 backdrop-blur-sm p-5 shadow-[0_4px_24px_rgba(15,23,42,0.08)] border border-[hsl(var(--color-border))] flex-1 transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_8px_32px_rgba(15,23,42,0.12)]">
          <h3 class="text-xl font-black text-[hsl(var(--color-foreground))]">{card.title}</h3>
          <p class="mt-2 text-sm text-[hsl(var(--color-muted-foreground))] leading-normal">{card.body}</p>
          <a
            href={card.href}
            class="mt-4 inline-flex items-center gap-2 rounded-lg bg-[hsl(var(--color-primary))] px-5 py-2.5 text-sm font-bold text-[hsl(var(--color-primary-foreground))] transition hover:bg-[hsl(var(--color-primary))]/90"
          >
            Explore
          </a>
        </article>
        {index < cards.length - 1 && (
          <svg class="h-6 w-6 shrink-0 text-[hsl(var(--color-primary))]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14" /><path d="m12 5 7 7-7 7" />
          </svg>
        )}
      </div>
    ))}
  </div>

  <!-- Mobile: vertical stack with down arrows -->
  <div class="flex flex-col items-center gap-3 lg:hidden">
    {cards.map((card, index) => (
      <div class="flex flex-col items-center w-full">
        <article class="flex flex-col items-center text-center rounded-2xl bg-white/80 backdrop-blur-sm p-5 shadow-[0_4px_24px_rgba(15,23,42,0.08)] border border-[hsl(var(--color-border))] w-full max-w-[320px] transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_8px_32px_rgba(15,23,42,0.12)]">
          <h3 class="text-xl font-black text-[hsl(var(--color-foreground))]">{card.title}</h3>
          <p class="mt-2 text-sm text-[hsl(var(--color-muted-foreground))] leading-normal">{card.body}</p>
          <a
            href={card.href}
            class="mt-4 inline-flex items-center gap-2 rounded-lg bg-[hsl(var(--color-primary))] px-5 py-2.5 text-sm font-bold text-[hsl(var(--color-primary-foreground))] transition hover:bg-[hsl(var(--color-primary))]/90"
          >
            Explore
          </a>
        </article>
        {index < cards.length - 1 && (
          <svg class="h-5 w-5 shrink-0 text-[hsl(var(--color-primary))]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 5v14" /><path d="m19 12-7 7-7-7" />
          </svg>
        )}
      </div>
    ))}
  </div>
</div>

---
const cards = [
  {
    title: "Document",
    body: "Session notes for each CPT code with CASP guidance. One record feeds treatment plans, assessments, and clinical monthly reports — no re-entering a single word.",
    href: "/solutions#document",
  },
  {
    title: "Collect",
    body: "Five collection methods with live graphs the moment data is recorded. Every data point feeds trend analysis that evaluates progress against each objective automatically.",
    href: "/solutions#collect",
  },
  {
    title: "Operate",
    body: "Scheduling with conflict detection, authorization tracking, and billing — all pulling from the same record your clinical team writes to.",
    href: "/solutions#operate",
  },
  {
    title: "Comply",
    body: "Monthly supervision reports assembled from 97155 appointments. Case logs calculate coverage against the 10% threshold. Every record audit-ready with a complete history.",
    href: "/solutions#comply",
  },
  {
    title: "Configure",
    body: "Service plans, billing codes, data collection methods, and role permissions defined once per organization — enforced everywhere across every module.",
    href: "/solutions#configure",
  },
];
---

<div class="mt-16">
  <!-- Desktop: horizontal row with arrows -->
  <div class="hidden lg:flex items-center justify-center gap-4">
    {cards.map((card, index) => (
      <div class="flex items-center gap-4">
        <article class="flex flex-col items-center text-center rounded-2xl bg-white p-6 shadow-[0_4px_24px_rgba(15,23,42,0.08)] border border-[hsl(var(--color-border))] w-[200px] shrink-0 transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_8px_32px_rgba(15,23,42,0.12)]">
          <h3 class="text-lg font-black text-[hsl(var(--color-foreground))]">{card.title}</h3>
          <p class="mt-2 text-sm text-[hsl(var(--color-muted-foreground))] min-h-[3rem]">{card.body}</p>
          <a
            href={card.href}
            class="mt-4 inline-flex items-center gap-2 rounded-lg bg-[hsl(var(--color-primary))] px-4 py-2 text-xs font-bold text-[hsl(var(--color-primary-foreground))] transition hover:bg-[hsl(var(--color-primary))]/90"
          >
            Explore
          </a>
        </article>
        {index < cards.length - 1 && (
          <svg class="h-5 w-5 shrink-0 text-[hsl(var(--color-primary))]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14" /><path d="m12 5 7 7-7 7" />
          </svg>
        )}
      </div>
    ))}
  </div>

  <!-- Mobile: vertical stack with down arrows -->
  <div class="flex flex-col items-center gap-3 lg:hidden">
    {cards.map((card, index) => (
      <div class="flex flex-col items-center">
        <article class="flex flex-col items-center text-center rounded-2xl bg-white p-6 shadow-[0_4px_24px_rgba(15,23,42,0.08)] border border-[hsl(var(--color-border))] w-full max-w-[280px] transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_8px_32px_rgba(15,23,42,0.12)]">
          <h3 class="text-lg font-black text-[hsl(var(--color-foreground))]">{card.title}</h3>
          <p class="mt-2 text-sm text-[hsl(var(--color-muted-foreground))]">{card.body}</p>
          <a
            href={card.href}
            class="mt-4 inline-flex items-center gap-2 rounded-lg bg-[hsl(var(--color-primary))] px-4 py-2 text-xs font-bold text-[hsl(var(--color-primary-foreground))] transition hover:bg-[hsl(var(--color-primary))]/90"
          >
            Explore
          </a>
        </article>
        {index < cards.length - 1 && (
          <svg class="h-5 w-5 shrink-0 text-[hsl(var(--color-primary))] my-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 5v14" /><path d="m19 12-7 7-7-7" />
          </svg>
        )}
      </div>
    ))}
  </div>
</div>

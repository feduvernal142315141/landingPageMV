---
import Button from "../ui/Button.astro";
import Icon from "../ui/Icon.astro";
import DashboardFrame from "../ui/DashboardFrame.astro";
---

<section id="hero" aria-label="Hero" class="relative bg-[hsl(var(--color-bg-warm))] lg:min-h-[800px]">
  <div class="relative mx-auto max-w-7xl px-6 pb-0 pt-[52px] lg:pb-0 lg:pt-[100px]">
    <div class="hero-grid">
      <!-- Left column: Title, subtitle, CTAs -->
      <div class="hero-content lg:-translate-y-5">
        <!-- Eyebrow with floating effect -->
        <div class="inline-flex items-center gap-3 px-5 py-2 rounded-full bg-[hsl(var(--color-primary)/0.1)] text-[hsl(var(--color-primary))] text-[0.95rem] font-medium animate-float-pulse-more border border-[hsl(var(--color-primary)/0.35)] lg:translate-y-[-30px]" style="font-family: var(--font-heading);">
          <Icon name="users" class="h-4 w-4" />
          <span>Made-to-measure for ABA Providers</span>
        </div>
        <h1 class="text-3xl font-black tracking-tight text-[hsl(var(--color-foreground))] sm:text-4xl lg:text-5xl xl:text-6xl" style="font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;">
          <span class="lg:hidden">
            Simplify Your ABA Practice<br />
            with <span class="text-[hsl(var(--color-primary))]">Specialized</span><br />
            <span class="text-[hsl(var(--color-primary))]">Management Software</span>
          </span>
          <span class="hidden lg:block">
            Simplify Your<br />
            ABA Practice<br />
            with <span class="text-[hsl(var(--color-primary))]">Specialized</span><br />
            <span class="text-[hsl(var(--color-primary))]">Management</span><br />
            <span class="text-[hsl(var(--color-primary))]">Software</span>
          </span>
        </h1>
        <p class="mt-6 max-w-2xl text-2xl font-medium leading-relaxed text-[hsl(var(--color-foreground))]">
          <span class="lg:hidden text-lg">
            All-in-one software for ABA and Mental Health<br />
            clinics to manage scheduling, session notes,<br />
            data collection, supervision, and billing.
          </span>
          <span class="hidden lg:block">
            All-in-one software for ABA and Mental Health clinics to<br />
            manage scheduling, session notes, data collection,<br />
            supervision, and billing.
          </span>
        </p>
        <div class="mt-8 flex flex-row items-center justify-center gap-3 lg:flex-wrap lg:justify-start lg:ml-10">
          <Button href="#features" variant="hero" icon="sparkles" class="!text-sm !px-4 !py-2">Explore Features</Button>
          <Button href="#solutions" variant="hero" icon="compass" class="!text-sm !px-4 !py-2">Explore Solutions</Button>
        </div>
      </div>

      <!-- Right column: Dashboard frame (Clinicia-style) -->
      <div class="hero-dashboard lg:block">
        <DashboardFrame />
        <!-- Feature highlights row -->
        <div class="mt-4 flex flex-wrap justify-center gap-x-6 gap-y-3 text-sm text-[hsl(var(--color-foreground))] lg:mt-[64px] lg:justify-start">
          <span class="flex items-center gap-1.5 whitespace-nowrap">
            <svg class="h-4 w-4 text-[hsl(var(--color-primary))]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            <span>HIPAA compliant</span>
          </span>
          <span class="flex items-center gap-2">
            <svg class="h-4 w-4 text-[hsl(var(--color-primary))]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Audit-ready documentation</span>
          </span>
          <span class="flex items-center gap-2">
            <svg class="h-4 w-4 text-[hsl(var(--color-primary))]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Crafted with BCBAs</span>
          </span>
        </div>
      </div>
    </div>
  </div>

<!-- Floating icons (Clinicia-style scattered) -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 overflow-hidden">
    <!-- Icon 1: layout-dashboard (Command center) - LEFT -->
    <Icon name="layout-dashboard" class="absolute top-[8%] left-[5%] h-8 w-8 text-[hsl(var(--color-primary))] opacity-15 animate-float-drift" style="animation-delay: -2s;" />
    <!-- Icon 2: calendar (Scheduling) - RIGHT -->
    <Icon name="calendar" class="absolute top-[12%] right-[2%] h-7 w-7 text-[hsl(var(--color-primary))] opacity-50 animate-float-pulse" style="animation-delay: -4s;" />
    <!-- Icon 3: file-text (Session notes/docs) - LEFT -->
    <Icon name="file-text" class="absolute top-[20%] left-[3%] h-7 w-7 text-[hsl(var(--color-primary))] opacity-15 animate-float-rotate" style="animation-delay: -6s;" />
    <!-- Icon 4: chart-line (Progress/data) - RIGHT -->
    <Icon name="chart-line" class="absolute top-[25%] right-[4%] h-7 w-7 text-[hsl(var(--color-primary))] opacity-50 animate-float-drift" style="animation-delay: -8s;" />
    <!-- Icon 5: users (Team/collaboration) - LEFT -->
    <Icon name="users" class="absolute top-[35%] left-[2%] h-8 w-8 text-[hsl(var(--color-primary))] opacity-15 animate-float-pulse" style="animation-delay: -10s;" />
    <!-- Icon 6: shield (Compliance/security) - RIGHT -->
    <Icon name="shield" class="absolute top-[45%] right-[1%] h-8 w-8 text-[hsl(var(--color-primary))] opacity-50 animate-float-rotate" style="animation-delay: -12s;" />
    <!-- Icon 7: credit-card (Billing) - LEFT -->
    <Icon name="credit-card" class="absolute top-[55%] left-[8%] h-7 w-7 text-[hsl(var(--color-primary))] opacity-15 animate-float-drift" style="animation-delay: -14s;" />
    <!-- Icon 8: book-open (Supervision/plans) - RIGHT -->
    <Icon name="book-open" class="absolute top-[65%] right-[3%] h-8 w-8 text-[hsl(var(--color-primary))] opacity-50 animate-float-pulse" style="animation-delay: -16s;" />
    <!-- Icon 9: database (Data collection) - LEFT -->
    <Icon name="database" class="absolute top-[75%] left-[4%] h-8 w-8 text-[hsl(var(--color-primary))] opacity-15 animate-float-rotate" style="animation-delay: -18s;" />
    <!-- Icon 10: check-circle (Audit-ready) - RIGHT -->
    <Icon name="check-circle" class="absolute top-[85%] right-[1%] h-7 w-7 text-[hsl(var(--color-primary))] opacity-50 animate-float-drift" style="animation-delay: -20s;" />
  </div>

  <style>
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: start;
  }

  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: 1.1fr 0.9fr;
      grid-template-areas: 
        "content dashboard";
    }

    .hero-content {
      grid-area: content;
    }

    .hero-dashboard {
      grid-area: dashboard;
    }
  }

  .hero-content {
    text-align: left;
  }

  .hero-dashboard {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-end;
    gap: 2rem;
    padding-top: 2rem;
  }

  @media (max-width: 1023px) {
    .hero-content {
      grid-area: auto;
      text-align: left;
    }

    .hero-content > .inline-flex {
      margin-bottom: 1rem;
    }

    .hero-content .flex {
      justify-content: center;
    }

    .hero-content > div:last-child {
      justify-content: center;
      margin-left: 0;
    }

    .hero-dashboard {
      grid-area: auto;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-start;
      padding-top: 0;
      margin-top: -1rem;
      gap: 2.5rem;
    }

    .hero-dashboard > div > div > :nth-child(3) {
      margin-left: auto;
      margin-right: auto;
    }
  }
</style>

<style is:global>
  @media (max-width: 1023px) {
    .hero-dashboard > div:first-child {
      order: 2;
    }

    .hero-dashboard > div:last-child {
      order: 1;
    }
  }
</style>
</section>
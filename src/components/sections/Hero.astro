---
import { Image } from "astro:assets";
import { site } from "../../data/site";
import Button from "../ui/Button.astro";
import Icon from "../ui/Icon.astro";
---

<section id="hero" aria-label="Hero" class="relative bg-[hsl(var(--color-bg-primary))] lg:min-h-[960px]">
  <div class="relative mx-auto max-w-7xl px-6 pb-24 pt-[52px] text-center lg:text-left lg:pb-32 lg:pt-[100px]">
    <h1 class="text-3xl font-black tracking-tight text-[hsl(var(--color-foreground))] sm:text-4xl lg:text-5xl xl:text-6xl">
      <span class="lg:hidden">
        Simplify Your ABA Practice<br />
        with <span class="text-[hsl(var(--color-primary))]">Specialized</span><br />
        <span class="text-[hsl(var(--color-primary))]">Management Software</span>
      </span>
      <span class="hidden lg:block">
        Simplify Your<br />
        ABA Practice<br />
        with <span class="text-[hsl(var(--color-primary))]">Specialized</span><br />
        <span class="text-[hsl(var(--color-primary))]">Management</span><br />
        <span class="text-[hsl(var(--color-primary))]">Software</span>
      </span>
    </h1>
    <p class="mt-6 max-w-2xl text-2xl font-medium leading-relaxed text-[hsl(var(--color-foreground))]">
      <span class="lg:hidden text-lg">
        All-in-one software for ABA providers<br />
        to manage scheduling, session notes,<br />
        data collection, supervision, and billing.
      </span>
      <span class="hidden lg:block">
        All-in-one software for ABA providers<br />
        to manage scheduling, session notes, data collection,<br />
        supervision, and billing.
      </span>
    </p>
    <div class="mt-8 flex flex-col items-center gap-4 lg:flex-row lg:flex-wrap lg:justify-start">
      <Button href="#features" variant="hero" icon="sparkles">Explore Features</Button>
      <Button href="#solutions" variant="hero" icon="compass">Explore Solutions</Button>
    </div>
    <div class="mt-6 flex justify-center lg:justify-start lg:ml-[120px] lg:mt-8">
      <Button href={site.demoUrl} icon="rocket">Request a Demo</Button>
    </div>
  </div>

  <!-- Floating icons (Clinicia-style scattered) -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 overflow-hidden">
    <!-- Icon 1: layout-dashboard (Command center) -->
    <Icon name="layout-dashboard" class="absolute top-[8%] left-[5%] h-10 w-10 text-[hsl(var(--color-primary))] opacity-10 animate-float-drift" style="animation-delay: -2s;" />
    <!-- Icon 2: calendar (Scheduling) -->
    <Icon name="calendar" class="absolute top-[12%] right-[8%] h-8 w-8 text-[hsl(var(--color-primary))] opacity-10 animate-float-pulse" style="animation-delay: -4s;" />
    <!-- Icon 3: file-text (Session notes/docs) -->
    <Icon name="file-text" class="absolute top-[20%] left-[3%] h-9 w-9 text-[hsl(var(--color-primary))] opacity-10 animate-float-rotate" style="animation-delay: -6s;" />
    <!-- Icon 4: chart-line (Progress/data) -->
    <Icon name="chart-line" class="absolute top-[25%] right-[15%] h-8 w-8 text-[hsl(var(--color-primary))] opacity-10 animate-float-drift" style="animation-delay: -8s;" />
    <!-- Icon 5: users (Team/collaboration) -->
    <Icon name="users" class="absolute top-[35%] left-[2%] h-10 w-10 text-[hsl(var(--color-primary))] opacity-10 animate-float-pulse" style="animation-delay: -10s;" />
    <!-- Icon 6: shield (Compliance/security) -->
    <Icon name="shield" class="absolute top-[45%] right-[5%] h-9 w-9 text-[hsl(var(--color-primary))] opacity-10 animate-float-rotate" style="animation-delay: -12s;" />
    <!-- Icon 7: credit-card (Billing) -->
    <Icon name="credit-card" class="absolute top-[55%] left-[8%] h-8 w-8 text-[hsl(var(--color-primary))] opacity-10 animate-float-drift" style="animation-delay: -14s;" />
    <!-- Icon 8: book-open (Supervision/plans) -->
    <Icon name="book-open" class="absolute top-[65%] right-[12%] h-9 w-9 text-[hsl(var(--color-primary))] opacity-10 animate-float-pulse" style="animation-delay: -16s;" />
    <!-- Icon 9: database (Data collection) -->
    <Icon name="database" class="absolute top-[75%] left-[4%] h-10 w-10 text-[hsl(var(--color-primary))] opacity-10 animate-float-rotate" style="animation-delay: -18s;" />
    <!-- Icon 10: check-circle (Audit-ready) -->
    <Icon name="check-circle" class="absolute top-[85%] right-[3%] h-8 w-8 text-[hsl(var(--color-primary))] opacity-10 animate-float-drift" style="animation-delay: -20s;" />
  </div>

  <!-- MacBook/iPhone frames with navy borders -->
  <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-full max-w-7xl px-6 pb-10 lg:pb-20 pointer-events-none">
    <div class="flex justify-center lg:justify-end gap-4">
      <!-- MacBook frame -->
      <div class="hidden lg:block macbook-frame relative z-10" style="width: 520px; height: 325px;">
        <div class="absolute inset-0 bg-white rounded-xl border-2 border-[hsl(var(--color-foreground))] shadow-[0_28px_72px_-16px_rgba(15,23,42,0.08),0_10px_32px_-10px_rgba(15,23,42,0.06),0_0_0_1px_rgba(226,232,240,0.45)] overflow-hidden" style="border-radius: 16px 16px 4px 4px;">
          <div class="absolute top-2 left-1/2 -translate-x-1/2 w-20 h-1.5 bg-[hsl(var(--color-muted))] rounded-full" />
          <div class="absolute inset-4 bg-[hsl(var(--color-bg-primary))] rounded-lg flex items-center justify-center p-4">
            <Image
              src={await import("../../assets/mentevior-dashboard.png").then(m => m.default)}
              alt="MenteVior dashboard"
              width={800}
              height={500}
              class="h-full w-full object-contain object-top"
            />
          </div>
        </div>
        <div class="absolute bottom-[-8px] left-1/2 -translate-x-1/2 w-16 h-2 bg-[hsl(var(--color-muted))] rounded-full" />
      </div>

      <!-- iPhone frame -->
      <div class="iphone-frame relative z-20" style="width: 180px; height: 360px;">
        <div class="absolute inset-0 bg-white rounded-[36px] border-4 border-[hsl(var(--color-foreground))] shadow-[0_28px_72px_-16px_rgba(15,23,42,0.08),0_10px_32px_-10px_rgba(15,23,42,0.06),0_0_0_1px_rgba(226,232,240,0.45)] overflow-hidden">
          <div class="absolute top-3 left-1/2 -translate-x-1/2 w-12 h-1.5 bg-[hsl(var(--color-muted))] rounded-full" />
          <div class="absolute inset-6 bg-[hsl(var(--color-bg-primary))] rounded-[24px] flex items-center justify-center p-2">
            <Image
              src={await import("../../assets/mentevior-dashboard-mobile.png").then(m => m.default)}
              alt="MenteVior mobile dashboard"
              width={300}
              height={600}
              class="h-full w-full object-cover object-top"
            />
          </div>
        </div>
        <div class="absolute bottom-[-10px] left-1/2 -translate-x-1/2 w-8 h-1 bg-[hsl(var(--color-muted))] rounded-full" />
      </div>
    </div>
  </div>
</section>

<style is:global>
  /* MacBook frame styles */
  .macbook-frame {
    position: relative;
    width: 100%;
    max-width: 520px;
    aspect-ratio: 16/10;
  }

  .macbook-frame::before {
    content: "";
    position: absolute;
    bottom: -8px;
    left: 50%;
    transform: translateX(-50%);
    width: 64px;
    height: 4px;
    background: hsl(var(--color-muted));
    border-radius: 4px;
    z-index: -1;
  }

  /* iPhone frame styles */
  .iphone-frame {
    position: relative;
    width: 100%;
    max-width: 180px;
    aspect-ratio: 9/19.5;
  }

  .iphone-frame::after {
    content: "";
    position: absolute;
    bottom: -10px;
    left: 50%;
    transform: translateX(-50%);
    width: 32px;
    height: 4px;
    background: hsl(var(--color-muted));
    border-radius: 4px;
    z-index: -1;
  }
</style>
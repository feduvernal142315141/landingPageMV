---
import { features } from "../../data/features";
import IconBadge from "../IconBadge.astro";
import Section from "./Section.astro";
---

<Section
  id="features"
  ariaLabel="Features"
  class="relative overflow-hidden bg-white bg-grid-pattern"
  containerClass="relative"
>
  <div class="scroll-reveal slide-up mx-auto max-w-2xl text-center">
    <span class="inline-flex items-center px-4 py-1.5 rounded-full bg-[hsl(var(--color-primary))]/10 border border-[hsl(var(--color-primary))]/20 text-xs font-bold uppercase tracking-widest text-[hsl(var(--color-primary))] mb-3 block">
      Features
    </span>
    <h2 class="mt-3 text-3xl font-black tracking-tight sm:text-4xl text-[hsl(var(--color-foreground))]">
      Smart Features To Elevate Your Care
    </h2>
    <p class="mt-4 text-lg text-[hsl(var(--color-muted-foreground))] font-normal tracking-wide">
      The operating system for modern ABA practices
    </p>
  </div>

  <ul class="mt-14 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
    {
      features.map((feature, i) => (
        <li class="scroll-reveal slide-up rounded-2xl border-2 border-[hsl(var(--color-primary))] bg-white p-8 text-center transition hover:-translate-y-1 hover:bg-[hsl(var(--color-muted))]" style={`transition-delay: ${i * 100}ms`}>
          <IconBadge name={feature.icon} />
          <h3 class="mt-4 text-lg font-bold text-[hsl(var(--color-foreground))]">{feature.title}</h3>
          <ul class="mt-4 space-y-2 text-left">
            <li class="flex items-start gap-2 text-base leading-relaxed text-[hsl(var(--color-foreground))]">
              <span class="mt-1.5 h-1 w-1 shrink-0 rounded-full bg-[hsl(var(--color-primary))]" />
              {feature.points[0]}
            </li>
            <li class="flex items-start gap-2 text-base leading-relaxed text-[hsl(var(--color-foreground))]">
              <span class="mt-1.5 h-1 w-1 shrink-0 rounded-full bg-[hsl(var(--color-primary))]" />
              {feature.points[1]}
            </li>
            {feature.points[2] && (
              <li class="flex items-start gap-2 text-base leading-relaxed text-[hsl(var(--color-foreground))]">
                <span class="mt-1.5 h-1 w-1 shrink-0 rounded-full bg-[hsl(var(--color-primary))]" />
                {feature.points[2]}
              </li>
            )}
          </ul>
        </li>
      ))
    }
  </ul>
</Section>
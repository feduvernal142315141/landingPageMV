---
import { pricingPlans } from "../../data/pricing";
import { site } from "../../data/site";
import Section from "./Section.astro";
import Button from "../ui/Button.astro";
---

<Section
  id="pricing"
  ariaLabel="Pricing Plans"
  class="relative overflow-hidden scroll-mt-[-20px]"
  containerClass="relative"
  style="background: hsl(245, 50%, 12%);"
>
  <div class="mx-auto max-w-7xl px-6 pt-2 pb-20 lg:pt-6 lg:pb-28 -mt-5">
    <div class="scroll-reveal slide-up text-center mb-16">
      <span class="inline-flex items-center px-4 py-1.5 rounded-full bg-white/10 border border-white/20 text-sm font-bold uppercase tracking-widest text-[hsl(var(--color-primary))] mb-3 block">
        Pricing
      </span>
      <h2 class="text-3xl font-black tracking-tight text-white sm:text-4xl">
        Plans that grow with your practice
      </h2>
      <p class="mt-4 text-lg text-white font-normal tracking-wide">
        Pricing is <span class="font-bold">tailored to your</span> practice size and services.
      </p>
    </div>

    <div class="grid gap-8 md:grid-cols-3">
      {pricingPlans.map((plan, index) => (
        <article class="scroll-reveal slide-up relative rounded-2xl bg-[hsl(var(--color-bg-warm))] p-8 text-center transition-all duration-300 hover:-translate-y-1 hover:shadow-xl" style={`transition-delay: ${index * 100}ms; ${plan.popular ? 'transform: scale(1.05);' : ''}`}>
          {plan.popular && (
            <div class="absolute -top-3 left-1/2 -translate-x-1/2">
              <span class="inline-flex items-center px-3 py-1 rounded-full bg-[hsl(var(--color-primary))] text-sm font-bold uppercase tracking-widest text-[hsl(var(--color-primary-foreground))]">
                Most Popular
              </span>
            </div>
          )}
          <div class="text-center mb-6">
            <h3 class="text-xl font-black text-[hsl(var(--color-foreground))]">{plan.name}</h3>
            <p class="mt-2 text-sm text-[hsl(var(--color-primary))]">{plan.audience}</p>
          </div>
          <div class="mb-8">
            <span class="text-4xl font-black text-[hsl(var(--color-foreground))]">{plan.price}</span>
          </div>
          <ul class="space-y-4 text-left mb-8">
            {plan.features.map((feature) => (
              <li class="flex items-center gap-3 text-left">
                <span class="h-1 w-1 shrink-0 rounded-full bg-[hsl(var(--color-primary))]" />
                <span class="text-base leading-relaxed text-[hsl(var(--color-muted-foreground))]">{feature}</span>
              </li>
            ))}
          </ul>
          <Button
            href={plan.ctaHref}
            variant={plan.popular ? "cta-primary" : "cta-navy"}
            class="w-full"
          >
            {plan.ctaText}
          </Button>
        </article>
      ))}
    </div>

    <p class="mt-12 text-center text-sm text-white/70">
      <a href={site.demoUrl} class="font-semibold underline hover:underline-offset-2 text-white">
        Book a demo
      </a>{' '}
      and we'll scope it with your numbers; there's no setup fee to evaluate.
    </p>
  </div>
</Section>
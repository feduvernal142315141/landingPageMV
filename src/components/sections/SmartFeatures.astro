---
import { smartFeatures } from "../../data/smartFeatures";
import { icons } from "../../data/icons";
import Section from "./Section.astro";
---

<Section
  id="smart-features"
  ariaLabel="Smart Features"
  class="relative overflow-hidden bg-white bg-grid-pattern"
  containerClass="relative"
>
  <div class="scroll-reveal slide-up mx-auto max-w-2xl text-center">
    <span class="inline-flex items-center px-4 py-1.5 rounded-full bg-[hsl(var(--color-primary))]/10 border border-[hsl(var(--color-primary))]/20 text-sm font-bold uppercase tracking-widest text-[hsl(var(--color-primary))] mb-3 block">
      Features
    </span>
    <h2 class="mt-3 text-3xl font-black tracking-tight sm:text-4xl text-[hsl(var(--color-foreground))]">
      Smart Features To Elevate Your Care
    </h2>
    <p class="mt-4 text-lg text-[hsl(var(--color-primary))] font-normal tracking-wide">
      The operating system for <span class="font-bold">modern ABA practices</span>
    </p>
  </div>

  <div class="mt-20 space-y-24">
    {smartFeatures.map((feature, i) => (
      <div class="scroll-reveal slide-up flex flex-col items-center text-center">
        <span class="inline-flex items-center px-4 py-1.5 rounded-full bg-[hsl(var(--color-primary))]/10 border border-[hsl(var(--color-primary))]/20 text-sm font-bold uppercase tracking-widest text-[hsl(var(--color-primary))]">
          {feature.eyebrow}
        </span>
        <h3 class="mt-4 text-3xl font-black tracking-tight sm:text-4xl text-[hsl(var(--color-foreground))]">
          {feature.title}
        </h3>
        <p class="mt-4 max-w-3xl text-lg text-[hsl(var(--color-muted-foreground))] leading-relaxed">
          {feature.description}
        </p>
        <ul class="mt-10 grid w-full max-w-3xl grid-cols-1 gap-3 sm:grid-cols-2">
          {feature.bullets.map((bullet) => (
            <li class="flex items-start gap-3 rounded-xl bg-[hsl(var(--color-primary))]/5 border border-[hsl(var(--color-primary))]/10 p-4 text-left">
              <svg class="mt-0.5 h-5 w-5 shrink-0 text-[hsl(var(--color-primary))]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" set:html={icons[bullet.icon]} />
              <span class="font-bold text-[hsl(var(--color-foreground))]">{bullet.text}</span>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</Section>

---
import { smartFeatures } from "../../data/smartFeatures";
import { icons } from "../../data/icons";
---

<section id="smart-features" aria-label="Smart Features" class="relative overflow-hidden bg-[hsl(var(--color-bg-warm))] bg-grid-pattern">
  <div class="bg-[hsl(var(--color-primary))] py-16 sm:py-20">
    <div class="scroll-reveal slide-up mx-auto max-w-2xl text-center px-6">
      <span class="inline-flex items-center px-4 py-1.5 rounded-full bg-white/10 border border-white/20 text-sm font-bold uppercase tracking-widest text-white mb-3 block">
        Features
      </span>
      <h2 class="mt-3 text-3xl font-black tracking-tight sm:text-4xl text-[hsl(var(--color-foreground))]">
        Smart Features To Elevate Your Care
      </h2>
      <p class="mt-4 text-lg text-white/90 font-normal tracking-wide">
        The operating system for <span class="font-bold">modern ABA practices</span>
      </p>
    </div>
  </div>

  <div class="mx-auto max-w-7xl px-6 py-20 lg:py-28">
    <div class="space-y-16">
      {smartFeatures.map((feature, i) => (
        <div class="scroll-reveal slide-up relative rounded-2xl border border-[hsl(var(--color-primary))]/20 bg-[hsl(210,40%,88%)] p-8 sm:p-12">
          <svg class="absolute left-6 top-6 h-8 w-8 text-[hsl(var(--color-primary))]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" set:html={icons[feature.icon]} />
          <span class="absolute right-6 top-6 text-2xl font-black text-[#0f172a]/40">0{i + 1}</span>
          <div class="flex flex-col items-center text-center">
            <h3 class="text-xl font-black tracking-tight sm:text-2xl bg-gradient-to-r from-[#0f172a] to-[hsl(var(--color-primary))] bg-clip-text text-transparent">
              {feature.title}
            </h3>
            <p class="mt-4 max-w-3xl text-lg text-[hsl(var(--color-muted-foreground))] leading-relaxed">
              {feature.description}
            </p>
            <ul class="mt-10 grid w-full max-w-3xl grid-cols-1 gap-3 sm:grid-cols-2">
              {feature.bullets.map((bullet) => (
                <li class="flex items-start gap-3 rounded-xl bg-[hsl(var(--color-primary))] p-4 text-left">
                  <svg class="mt-0.5 h-5 w-5 shrink-0 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" set:html={icons[bullet.icon]} />
                  <span class="font-bold text-white">{bullet.text}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

---
import { site } from "../../data/site";
import Icon from "../ui/Icon.astro";
---

<section class="bg-white border-t border-[hsl(var(--color-border))] border-b border-[hsl(var(--color-border))]">
  <div class="mx-auto max-w-full px-6 py-6 flex flex-col md:flex-row items-center justify-between gap-4">
    <!-- Phone (Left) -->
    <div class="flex items-center gap-3">
      <Icon name="phone" class="h-6 w-6 text-[hsl(var(--color-foreground))]" />
      <a href={`tel:${site.contact.phone}`} class="text-lg font-medium text-[hsl(var(--color-foreground))] hover:underline">
        {site.contact.phone}
      </a>
    </div>
    
    <!-- Divider (Desktop only) -->
    <div class="hidden md:block w-px h-8 bg-[hsl(var(--color-foreground))]/30" />
    
    <!-- Email (Right) -->
    <div class="flex items-center gap-3">
      <Icon name="mail" class="h-6 w-6 text-[hsl(var(--color-foreground))]" />
      <a href={`mailto:${site.contact.email}`} class="text-lg font-medium text-[hsl(var(--color-foreground))] hover:underline">
        {site.contact.email}
      </a>
    </div>
  </div>
</section>
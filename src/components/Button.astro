---
import Icon from "./ui/Icon.astro";

interface Props {
  href: string;
  variant?: "primary" | "outline" | "white" | "link" | "hero";
  icon?: string;
  class?: string;
}

const { href, variant = "primary", icon, class: className = "" } = Astro.props;

const variants: Record<string, string> = {
  primary:
    "inline-flex items-center gap-2.5 rounded-lg bg-gradient-to-r from-primary via-accent to-tertiary px-6 py-3 text-sm font-bold text-white shadow-[0_8px_24px_rgba(3,126,204,0.4)] transition hover:shadow-[0_10px_28px_rgba(3,126,204,0.5)]",
  outline:
    "inline-flex items-center gap-2.5 rounded-lg border border-navy/10 bg-white px-6 py-3 text-sm font-bold text-navy/80 transition hover:border-primary/40 hover:text-primary",
  white:
    "inline-flex items-center gap-2.5 rounded-lg bg-white px-6 py-3 text-sm font-bold text-primary shadow-[0_8px_24px_rgba(3,126,204,0.4)] transition hover:shadow-[0_10px_28px_rgba(3,126,204,0.5)]",
  link: "group inline-flex items-center gap-2 text-sm font-bold text-tertiary transition hover:text-white",
  hero: "inline-flex items-center gap-2.5 rounded-lg border-[3px] border-white bg-transparent px-6 py-3 text-sm font-black tracking-wide text-white transition hover:bg-white/10",
};
---

<a href={href} class={`${variants[variant]} ${className}`.trim()}>
  {icon && <Icon name={icon} class="h-4 w-4" />}
  <slot />
</a>


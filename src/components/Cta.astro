---
import { site } from "../data/site";
import Button from "./Button.astro";
---

<section
  id="contact"
  aria-label="Call to action"
  class="relative overflow-hidden bg-gradient-to-b from-navy to-dark-accent"
>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-tertiary/60 to-transparent"
  ></div>
  <div aria-hidden="true" class="pointer-events-none absolute inset-0">
    <div class="absolute left-1/2 top-0 h-96 w-96 -translate-x-1/2 rounded-full bg-accent/15 blur-3xl" />
    <div class="absolute bottom-0 right-1/4 h-72 w-72 rounded-full bg-primary/20 blur-3xl" />
  </div>

  <div class="relative mx-auto max-w-3xl px-6 py-20 text-center lg:py-28">
    <h2 class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
      Let's start working together to transform your ABA practice
    </h2>
    <p class="mt-4 text-lg text-white/70">
      Talk to our team and discover what MenteVior can do for your practice.
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
      <Button href={`mailto:${site.contact.email}`} variant="white">Contact us</Button>
    </div>
  </div>
</section>
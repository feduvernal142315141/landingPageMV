---
import { site } from "../data/site";
import Button from "./Button.astro";
---

<section
  id="contact"
  aria-label="Call to action"
  class="relative overflow-hidden bg-gradient-to-br from-primary via-accent to-tertiary"
>
  <div aria-hidden="true" class="pointer-events-none absolute inset-0">
    <div class="absolute -top-16 left-1/4 h-64 w-64 rounded-full bg-white/10 blur-3xl" />
    <div class="absolute bottom-0 right-1/4 h-64 w-64 rounded-full bg-navy/20 blur-3xl" />
  </div>

  <div class="relative mx-auto max-w-3xl px-6 py-20 text-center lg:py-28">
    <h2 class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
      Let's start working together to transform your ABA practice
    </h2>
    <p class="mt-4 text-lg text-white/85">
      Talk to our team and discover what MenteVior can do for your practice.
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
      <Button href={`mailto:${site.contact.email}`} variant="white">Contact us</Button>
    </div>
  </div>
</section>
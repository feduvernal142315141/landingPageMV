---
import { Image } from "astro:assets";
import logo from "../assets/MenteVior-logo.png";
import nameImg from "../assets/MenteVior-name.png";

interface Props {
  logoClass?: string;
  nameClass?: string;
  inverted?: boolean;
  href?: string;
  class?: string;
}

const {
  logoClass = "h-12 w-auto",
  nameClass = "h-6 w-auto",
  inverted = false,
  href,
  class: className = "flex items-center gap-2",
} = Astro.props;

const filter = inverted ? " brightness-[10] contrast-[0.9]" : "";
---

{
  href ? (
    <a href={href} class={className} aria-label="MenteVior home">
      <Image src={logo} alt="MenteVior logo" width={249} height={250} format="webp" class={`${logoClass}${filter}`} />
      <Image src={nameImg} alt="MenteVior" width={229} height={36} format="webp" class={`${nameClass}${filter}`} />
    </a>
  ) : (
    <div class={className}>
      <Image src={logo} alt="MenteVior logo" width={249} height={250} format="webp" class={`${logoClass}${filter}`} />
      <Image src={nameImg} alt="MenteVior" width={229} height={36} format="webp" class={`${nameClass}${filter}`} />
    </div>
  )
}
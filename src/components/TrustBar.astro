---
import { site } from "../data/site";
---

<section id="trust" aria-label="Trust badges" class="border-y border-navy/5 bg-surface">
  <div class="mx-auto max-w-7xl px-6 py-12">
    <p class="text-center text-xs font-semibold uppercase tracking-widest text-navy/70">
      Trusted by ABA providers
    </p>
    <ul class="mt-6 flex flex-wrap items-center justify-center gap-3">
      {
        site.trustBadges.map((badge) => (
          <li
            class="rounded-full border border-dashed border-navy/20 bg-white px-5 py-2 text-sm font-semibold text-navy/70"
          >
            {badge}
          </li>
        ))
      }
    </ul>
  </div>
</section>
---
import Icon from "./ui/Icon.astro";

interface Props {
  name: string;
  class?: string;
}

const { name, class: className = "" } = Astro.props;
---

<span
  class={`inline-flex h-11 w-11 items-center justify-center rounded-xl bg-[hsl(var(--color-primary))] shadow-[0_4px_14px_-4px_hsl(var(--color-primary))] transition-all duration-300 hover:shadow-[0_8px_24px_-4px_hsl(var(--color-primary))] hover:-translate-y-0.5 ${className}`}
>
  <Icon name={name} class="h-7 w-7 text-[hsl(var(--color-primary-foreground))]" />
</span>
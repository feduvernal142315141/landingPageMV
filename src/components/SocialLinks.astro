---
import { site } from "../data/site";
import Icon from "./ui/Icon.astro";

interface Props {
  class?: string;
  itemClass?: string;
}

const {
  class: className = "flex items-center gap-3",
  itemClass = "rounded-xl border border-white/10 bg-white/5 p-2.5 text-white/70 transition hover:-translate-y-0.5 hover:border-tertiary/50 hover:text-tertiary",
} = Astro.props;
---

<div class={className}>
  {
    site.social.map((s) => (
      <a href={s.href} aria-label={s.label} class={itemClass}>
        <Icon name={s.label.toLowerCase()} class="h-5 w-5" />
      </a>
    ))
  }
</div>


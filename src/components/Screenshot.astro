---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src?: string;
  alt?: string;
  label?: string;
  loading?: "lazy" | "eager";
}

const {
  src,
  alt = "MenteVior app screenshot",
  label = "Screenshot coming soon",
  loading = "lazy",
} = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/screenshots/*.{png,webp,jpg,jpeg,avif}",
  { eager: true },
);

const filename = src?.split("/").pop();
const key = filename
  ? Object.keys(images).find((k) => k.endsWith(`/${filename}`))
  : undefined;
const image = key ? images[key]?.default : undefined;
---

{
  image ? (
    <figure class="overflow-hidden rounded-2xl border border-white/15 bg-white/5 shadow-xl">
      <Image
        src={image}
        alt={alt}
        widths={[640, 960, 1280]}
        sizes="(min-width: 1024px) 50vw, 100vw"
        class="h-auto w-full"
        loading={loading}
      />
    </figure>
  ) : (
    <div class="flex items-center justify-center rounded-2xl border border-dashed border-white/15 bg-white/5 p-16">
      <p class="text-sm font-medium text-white/70">{label}</p>
    </div>
  )
}
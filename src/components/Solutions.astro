---
import { solutionCategories } from "../data/solutions";
import Section from "./Section.astro";
import SolutionCategory from "./SolutionCategory.astro";
---

<Section
  id="solutions"
  ariaLabel="Solutions"
  class="relative overflow-hidden bg-gradient-to-b from-navy to-dark-accent"
  containerClass="relative"
>
  <div slot="decor" aria-hidden="true" class="pointer-events-none absolute inset-0">
    <div class="absolute -top-24 right-1/4 h-80 w-80 rounded-full bg-accent/10 blur-3xl" />
    <div class="absolute bottom-0 left-1/4 h-72 w-72 rounded-full bg-primary/10 blur-3xl" />
  </div>

  <div class="mx-auto max-w-7xl px-6 py-20 lg:py-28">
    <div class="lg:flex lg:items-start lg:justify-between">
      <!-- Left side: Title and subtitle -->
      <div class="lg:w-1/2 lg:pr-12 lg:text-left text-center lg:text-left">
        <span class="inline-flex items-center px-4 py-1.5 rounded-full bg-white/10 border border-white/20 text-xs font-bold uppercase tracking-widest text-white mb-3 block lg:inline-block">
          Solutions
        </span>
        <h2 class="mt-3 text-3xl font-black tracking-tight sm:text-4xl text-white">
          All Your Workflows<br class="lg:hidden" /> Thoughtfully Connected
        </h2>
        <p class="mt-4 text-lg text-blue-400 font-normal tracking-wide">
          A full suite of integrated modules, designed to work together, out of the box.
        </p>
      </div>

      <!-- Right side: Cards stacked with overlap -->
      <div class="mt-14 lg:mt-0 lg:w-1/2 lg:pl-8">
        <div class="relative">
          {solutionCategories.map((category, index) => (
            <SolutionCategory
              category={category}
              showExplore={true}
              baseUrl="/solutions"
              showModules={false}
              isFirst={index === 0}
              isOverlapped={index > 0}
              isMobile={false}
              horizontalOffset={index === 0 ? 'left' : 'right'}
            />
          ))}
        </div>
      </div>
    </div>
  </div>
</Section>
---
import { solutionCategories } from "../data/solutions";
import IconBadge from "./IconBadge.astro";
import Section from "./Section.astro";
import Icon from "./Icon.astro";
---

<Section
  id="solutions"
  ariaLabel="Solutions"
  class="relative overflow-hidden bg-navy-dark"
  containerClass="relative"
>
  <div slot="decor" aria-hidden="true" class="pointer-events-none absolute inset-0">
    <div class="absolute -top-24 right-1/4 h-80 w-80 rounded-full bg-accent/10 blur-3xl" />
    <div class="absolute bottom-0 left-1/4 h-72 w-72 rounded-full bg-primary/10 blur-3xl" />
  </div>

  <div class="mx-auto max-w-2xl text-center">
    <span class="inline-flex items-center px-4 py-1.5 rounded-full bg-white/10 border border-white/20 text-xs font-bold uppercase tracking-widest text-white mb-3 block">
      Solutions
    </span>
    <h2 class="mt-3 text-3xl font-black tracking-tight sm:text-4xl text-blue-400">
      All Your Workflows<br class="lg:hidden" /> Thoughtfully Connected
    </h2>
    <p class="mt-4 text-lg text-white font-normal tracking-wide">
      A full suite of integrated modules, designed to work together, out of the box.
    </p>
  </div>

  {solutionCategories.map((category) => (
    <section id={category.anchor} class="mt-20">
      <div class="group rounded-2xl border border-white/10 bg-white/5 p-8 md:p-12 text-center transition">
        <div class="inline-flex h-24 w-24 items-center justify-center rounded-2xl bg-gradient-to-br from-primary to-accent text-white mb-6 mx-auto">
          <Icon name={category.icon} class="h-12 w-12" />
        </div>
        <h3 class="text-2xl font-black text-white mb-3">{category.label}</h3>
        <p class="text-lg text-white/80 mb-6 max-w-xl mx-auto">
          {category.description}
        </p>
        <a
          href={`#${category.anchor}`}
          class="inline-flex items-center gap-2 px-6 py-3 rounded-lg border-2 border-blue-400 text-blue-400 hover:bg-blue-400 hover:text-white transition-all duration-300 font-bold text-sm uppercase tracking-widest"
        >
          Explore
          <Icon name="compass" class="h-4 w-4" />
        </a>
      </div>

      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3 justify-center max-w-5xl mx-auto">
        {category.modules.map((module) => (
          <article class="group rounded-2xl border border-white/10 bg-white/5 p-6 text-center transition hover:border-accent/50 hover:bg-white/[0.08]">
            <IconBadge name={module.icon} class="mb-4" />
            <h4 class="font-bold text-white">{module.label}</h4>
          </article>
        ))}
      </div>
    </section>
  ))}
</Section>
---
import { whys } from "../data/solutions";
import IconBadge from "./IconBadge.astro";
import Section from "./Section.astro";
import Icon from "./Icon.astro";
---

<Section
  id="why"
  ariaLabel="Why MenteVior"
  class="relative overflow-hidden bg-navy-soft"
  containerClass="relative"
>
  <div slot="decor" aria-hidden="true" class="pointer-events-none absolute inset-0">
    <!-- Mesh gradient orbs -->
    <div class="absolute -top-20 left-1/3 h-80 w-80 rounded-full bg-accent/10 blur-3xl animate-pulse" style="animation-duration: 6s;" />
    <div class="absolute bottom-0 right-0 h-72 w-72 rounded-full bg-primary/10 blur-3xl animate-pulse" style="animation-duration: 7s; animation-delay: 1s;" />
    <!-- Floating icons (small, navy, in empty spaces around content) -->
    <Icon name="sparkles" class="absolute top-20 left-10 h-5 w-5 text-navy/20 animate-float-rotate" style="animation-delay: -3s;" />
    <Icon name="compass" class="absolute top-32 left-20 h-5 w-5 text-navy/20 animate-float-drift" style="animation-delay: -8s;" />
    <Icon name="layout-dashboard" class="absolute top-20 right-12 h-5 w-5 text-navy/20 animate-float-drift" style="animation-delay: -1s;" />
    <Icon name="book-open" class="absolute top-40 right-16 h-5 w-5 text-navy/20 animate-float-rotate" style="animation-delay: -12s;" />
    <!-- Upper middle area near title -->
    <Icon name="sparkles" class="absolute top-28 left-1/2 -translate-x-1/2 h-5 w-5 text-navy/20 animate-float-pulse" style="animation-delay: -4s;" />
    <Icon name="compass" class="absolute top-44 left-1/2 -translate-x-1/2 h-5 w-5 text-navy/20 animate-float-rotate" style="animation-delay: -11s;" />
    <Icon name="layout-dashboard" class="absolute top-16 left-1/2 -translate-x-1/2 h-5 w-5 text-navy/20 animate-float-drift" style="animation-delay: -7s;" />
    <Icon name="calendar" class="absolute left-8 top-1/2 h-5 w-5 text-navy/20 animate-float-pulse" style="animation-delay: -5s;" />
    <Icon name="layout-dashboard" class="absolute left-16 top-2/3 h-5 w-5 text-navy/20 animate-float-rotate" style="animation-delay: -14s;" />
    <Icon name="compass" class="absolute right-10 top-1/3 h-5 w-5 text-navy/20 animate-float-drift" style="animation-delay: -6s;" />
    <Icon name="sparkles" class="absolute right-14 top-3/4 h-5 w-5 text-navy/20 animate-float-pulse" style="animation-delay: -9s;" />
    <Icon name="book-open" class="absolute bottom-20 left-1/3 h-5 w-5 text-navy/20 animate-float-drift" style="animation-delay: -10s;" />
    <Icon name="calendar" class="absolute bottom-16 right-1/4 h-5 w-5 text-navy/20 animate-float-rotate" style="animation-delay: -2s;" />
  </div>

  <!-- Floating icons keyframes -->
  <style is:global>
    @keyframes float-rotate {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }
    @keyframes float-drift {
      0%, 100% { transform: translate(0, 0) rotate(0deg); }
      25% { transform: translate(12px, -8px) rotate(2deg); }
      50% { transform: translate(-8px, 12px) rotate(-1deg); }
      75% { transform: translate(8px, -4px) rotate(1deg); }
    }
    @keyframes float-pulse {
      0%, 100% { opacity: 0.015; transform: scale(1); }
      50% { opacity: 0.04; transform: scale(1.02); }
    }
    .animate-float-rotate { animation: float-rotate 22s linear infinite; will-change: transform; }
    .animate-float-drift { animation: float-drift 18s ease-in-out infinite; will-change: transform; }
    .animate-float-pulse { animation: float-pulse 10s ease-in-out infinite; will-change: transform, opacity; }
  </style>

  <div class="flex flex-col items-center">
    <h2 class="text-3xl font-bold tracking-tight sm:text-2xl bg-gradient-to-r from-accent-light to-tertiary bg-clip-text text-transparent">
      Why Choose MenteVior?
    </h2>
  </div>
  <div class="mt-6 mx-auto max-w-2xl text-center">
<h3 class="text-xl font-black tracking-tight sm:text-2xl text-white">
      The reasons our clients stay with us
</h3>
  </div>

  <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {
      whys.map((item) => (
        <div class="group flex flex-col items-center rounded-2xl border border-white/10 bg-white/5 p-6 text-center transition-all duration-300 hover:-translate-y-1.5 hover:border-accent/50 hover:bg-white/[0.08] hover:shadow-[0_20px_40px_-15px_rgba(0,0,0,0.45)]">
          <IconBadge name={item.icon} class="transition-transform duration-300 group-hover:scale-110" />
          <h3 class="mt-4 text-lg font-bold text-white">{item.title}</h3>
        </div>
      ))
    }
  </div>
</Section>
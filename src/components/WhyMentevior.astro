---
import { whys } from "../data/solutions";
import IconBadge from "./IconBadge.astro";
import Section from "./Section.astro";
---

<Section
  id="why"
  ariaLabel="Why MenteVior"
  class="relative overflow-hidden bg-dark-accent"
  containerClass="relative"
>
  <div slot="decor" aria-hidden="true" class="pointer-events-none absolute inset-0">
    <div class="absolute -top-20 left-1/3 h-80 w-80 rounded-full bg-accent/10 blur-3xl" />
    <div class="absolute bottom-0 right-0 h-72 w-72 rounded-full bg-primary/10 blur-3xl" />
  </div>

  <div class="flex flex-col items-center">
    <h2 class="text-3xl font-bold tracking-tight sm:text-2xl text-white">
      Why Choose MenteVior?
    </h2>
  </div>
  <div class="mt-6 mx-auto max-w-2xl text-center">
    <h3 class="text-xl font-black tracking-tight sm:text-2xl text-navy">
      The reasons our clients stay with us
    </h3>
  </div>

  <div class="mt-14 grid gap-6 sm:grid-cols-2">
    {
      whys.map((item) => (
        <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
          <IconBadge name={item.icon} />
          <h3 class="mt-4 text-lg font-bold text-white">{item.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-white/70">{item.description}</p>
        </div>
      ))
    }
  </div>
</Section>
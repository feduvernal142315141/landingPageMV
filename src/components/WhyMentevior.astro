---
import { whys } from "../data/features";

const iconPaths: Record<string, string> = {
  layers:
    '<polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/>',
  "line-chart":
    '<polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/>',
  shield: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>',
  headset:
    '<path d="M3 18v-6a9 9 0 0 1 18 0v6"/><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"/>',
};
---

<section id="why" aria-label="Why MenteVior" class="relative overflow-hidden bg-dark-accent">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0">
    <div class="absolute -top-20 left-1/3 h-80 w-80 rounded-full bg-accent/10 blur-3xl" />
    <div class="absolute bottom-0 right-0 h-72 w-72 rounded-full bg-primary/10 blur-3xl" />
  </div>

  <div class="relative mx-auto max-w-7xl px-6 py-20 lg:py-28">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-xs font-semibold uppercase tracking-widest text-accent-light">Why MenteVior</p>
      <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
        Built to help your practice grow
      </h2>
      <p class="mt-4 text-lg text-white/70">
        Focus on your clients while MenteVior takes care of the rest.
      </p>
    </div>

    <div class="mt-14 grid gap-6 sm:grid-cols-2">
      {
        whys.map((item) => (
          <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
            <span
              class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-gradient-to-br from-primary to-accent text-white"
            >
              <svg
                class="h-6 w-6"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={iconPaths[item.icon] ?? iconPaths.layers}
              />
            </span>
            <h3 class="mt-4 text-lg font-bold text-white">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-white/70">{item.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
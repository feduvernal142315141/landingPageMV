---
import { site } from "../data/site";
import Button from "./Button.astro";
import Section from "./Section.astro";
import SectionHeading from "./SectionHeading.astro";
---

<Section
  id="contact-section"
  ariaLabel="Contact us"
  class="relative overflow-hidden bg-navy"
  containerClass="relative"
>
  <div slot="decor" aria-hidden="true" class="pointer-events-none absolute inset-0">
    <div class="absolute -top-20 left-1/3 h-80 w-80 rounded-full bg-accent/10 blur-3xl" />
    <div class="absolute bottom-0 right-1/4 h-72 w-72 rounded-full bg-primary/10 blur-3xl" />
  </div>

  <SectionHeading
    eyebrow="Contact"
    title="Get in touch"
    subtitle="Have questions? We'd love to hear from you."
    dark
  />

  <div class="mt-14 flex flex-col items-center gap-6">
    <Button href={`mailto:${site.contact.email}`} variant="white">Contact us</Button>
  </div>
</Section>
